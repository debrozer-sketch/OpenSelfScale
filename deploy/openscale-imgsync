#!/bin/bash
set -u
CONF=/var/lib/openscale/imgsync.conf
LOCK=/run/openscale-imgsync.lock
[ -r "$CONF" ] || { echo "imgsync: нет $CONF" >&2; exit 1; }
. "$CONF"
: "${host:?}" "${user:?}" "${password:?}" "${remote_path:?}" "${local_dir:?}"
mkdir -p "$local_dir"
exec 9>"$LOCK"
flock -n 9 || exit 0
# S8: пароль не в argv (виден в ps) — передаётся через окружение lftp.
export LFTP_PASSWORD="$password"
lftp --env-password -u "$user" "$host" \
    -e "set net:timeout 30; set net:max-retries 2; \
        mirror --only-newer --no-perms $remote_path $local_dir; bye" \
    2>&1 | logger -t openscale-imgsync
exit ${PIPESTATUS[0]}
