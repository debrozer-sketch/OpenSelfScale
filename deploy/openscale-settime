#!/bin/bash
set -euo pipefail
usage() { echo 'usage: openscale-settime "ДД.ММ.ГГГГ ЧЧ:ММ" | openscale-settime ntp-on|ntp-off|ntp-server <host>' >&2; exit 1; }
if [ "$#" -eq 0 ]; then
    usage
fi
arg="$1"
if [ "$arg" = "ntp-on" ]; then
    timedatectl set-ntp true
    systemctl restart systemd-timesyncd
    exit 0
fi
if [ "$arg" = "ntp-off" ]; then
    timedatectl set-ntp false
    exit 0
fi
if [ "$arg" = "ntp-server" ]; then
    server="${2:-}"
    if [ -z "$server" ] || ! printf '%s' "$server" | grep -Eq '^[A-Za-z0-9._-]{1,253}$'; then
        echo "ntp-server <host>" >&2; exit 1
    fi
    mkdir -p /etc/systemd/timesyncd.conf.d
    printf '[Time]\nNTP=%s\n' "$server" > /etc/systemd/timesyncd.conf.d/openscale.conf
    systemctl restart systemd-timesyncd
    exit 0
fi
if [[ ! "$arg" =~ ^[0-9]{2}\.[0-9]{2}\.[0-9]{4}\ [0-9]{2}:[0-9]{2}$ ]]; then
    echo "Формат: ДД.ММ.ГГГГ ЧЧ:ММ" >&2; exit 1
fi
dd="${arg:0:2}"; mm="${arg:3:2}"; yy="${arg:6:4}"; hh="${arg:11:2}"; mi="${arg:14:2}"
if [ "$dd" -lt 1 ] || [ "$dd" -gt 31 ] || [ "$mm" -lt 1 ] || [ "$mm" -gt 12 ] \
   || [ "$hh" -gt 23 ] || [ "$mi" -gt 59 ]; then
    echo "Значения вне диапазона" >&2; exit 1
fi
if ! date -d "${yy}-${mm}-${dd} ${hh}:${mi}:00" +%s >/dev/null 2>&1; then
    echo "Некорректная дата" >&2; exit 1
fi
timedatectl set-ntp false
timedatectl set-time "${yy}-${mm}-${dd} ${hh}:${mi}:00"
