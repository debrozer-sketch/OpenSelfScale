#!/usr/bin/env python3
"""Применение сетевых настроек главного адреса весов.

Вызывается киоском через sudo (см. /etc/sudoers.d/scale-kiosk):
  scale-net-apply <IP> <PREFIX> <GATEWAY> <DNS>   — ручной (статический)
  scale-net-apply dhcp                            — DHCP (dhcpcd)
Применяет настройки живо (адрес, default route, resolv.conf) и перезаписывает
/etc/network/interfaces для сохранности после перезагрузки. Служебный адрес
разработки 172.32.0.5 не трогает.
"""
import ipaddress
import pathlib
import subprocess
import sys

IFACE = "enp3s0"
DEV_ADDR = "172.32.0.5/24"
INTERFACES = pathlib.Path("/etc/network/interfaces")
RESOLV = pathlib.Path("/etc/resolv.conf")

# ifupdown в Debian 13 не тянет dhcpcd сам — аренду на загрузке поднимает
# хук /etc/network/if-up.d/scale-dhcp (метод dhcp + наш скрипт).
INTERFACES_TEMPLATE = """\
source /etc/network/interfaces.d/*
auto lo
iface lo inet loopback

# Служебный адрес разработки; меню «Сеть» его не трогает.
allow-hotplug enp3s0
auto enp3s0
iface enp3s0 inet static
\taddress {ip}/{pre}
\tgateway {gw}
\tup ip addr add {dev} dev {iface} || true
\tdown ip addr del {dev} dev {iface} || true
"""

INTERFACES_DHCP_TEMPLATE = """\
source /etc/network/interfaces.d/*
auto lo
iface lo inet loopback

# Служебный адрес разработки; меню «Сеть» его не трогает.
allow-hotplug enp3s0
auto enp3s0
iface enp3s0 inet dhcp
\tup ip addr add {dev} dev {iface} || true
\tdown ip addr del {dev} dev {iface} || true
"""


def fail(msg: str) -> None:
    print(msg, file=sys.stderr)
    sys.exit(1)


def parse_addr(s: str, what: str) -> ipaddress.IPv4Address:
    try:
        return ipaddress.IPv4Address(s)
    except ValueError:
        fail(f"неверный {what}: {s}")


def main() -> None:
    if len(sys.argv) == 2 and sys.argv[1] == "dhcp":
        apply_dhcp()
        return
    if len(sys.argv) != 5:
        fail("использование: scale-net-apply <IP> <PREFIX> <GATEWAY> <DNS> | dhcp")
    ip_s, pre_s, gw_s, dns_s = sys.argv[1:5]
    ip = parse_addr(ip_s, "IP")
    try:
        pre = int(pre_s)
        if not 0 <= pre <= 32:
            raise ValueError
    except ValueError:
        fail(f"неверный префикс маски: {pre_s}")
    gw = parse_addr(gw_s, "шлюз")
    dns = parse_addr(dns_s, "DNS")

    # Живое применение без разрыва интерфейса.
    dev = ipaddress.IPv4Interface(DEV_ADDR)
    run = lambda *args: subprocess.run(args, check=False).returncode == 0

    run("ip", "addr", "replace", f"{ip}/{pre}", "dev", IFACE)
    # Старый главный адрес (если отличался) снять.
    out = subprocess.run(["ip", "-4", "addr", "show", "dev", IFACE],
                         capture_output=True, text=True).stdout
    new_main = f"{ip}/{pre}"
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("inet "):
            continue
        tok = line.split()[1]
        if tok in (new_main, str(dev)) or tok.startswith("127."):
            continue
        run("ip", "addr", "del", tok, "dev", IFACE)
    run("ip", "route", "replace", "default", "via", str(gw), "dev", IFACE)

    RESOLV.write_text(f"nameserver {dns}\n")

    INTERFACES.write_text(INTERFACES_TEMPLATE.format(ip=ip, pre=pre, gw=gw, dev=DEV_ADDR, iface=IFACE))
    print("ok")


def apply_dhcp() -> None:
    """Снять статические настройки главного адреса, получить аренду."""
    run = lambda *args: subprocess.run(args, check=False).returncode == 0
    dev = ipaddress.IPv4Interface(DEV_ADDR)

    # Старый главный адрес и его default route — долой, их заменит аренда.
    out = subprocess.run(["ip", "-4", "addr", "show", "dev", IFACE],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("inet "):
            continue
        tok = line.split()[1]
        if tok == str(dev) or tok.startswith("127."):
            continue
        run("ip", "addr", "del", tok, "dev", IFACE)
    run("ip", "route", "del", "default", "dev", IFACE)

    try:
        r = subprocess.run(["/usr/sbin/dhcpcd", "-1", IFACE], check=False, timeout=30,
                           capture_output=True, text=True)
    except subprocess.TimeoutExpired:
        fail("DHCP: нет ответа от сервера (таймаут)")
    if r.returncode != 0:
        fail(f"DHCP: dhcpcd завершился с ошибкой: {(r.stderr or r.stdout).strip()[:200]}")

    INTERFACES.write_text(INTERFACES_DHCP_TEMPLATE.format(dev=DEV_ADDR, iface=IFACE))
    print("ok")


if __name__ == "__main__":
    main()
