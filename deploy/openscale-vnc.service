[Unit]
Description=x11vnc mirror of the scale kiosk display (:0)
After=openscale-kiosk.service
Requires=openscale-kiosk.service

[Service]
User=@KIOSK_USER@
Environment=XAUTHORITY=/run/openscale-kiosk/X.auth
ExecStart=/usr/bin/x11vnc -display :0 -rfbport 5900 -localhost -rfbauth /home/@KIOSK_USER@/.config/tigervnc/passwd -forever -shared
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
