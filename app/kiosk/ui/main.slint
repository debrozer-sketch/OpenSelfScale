// Экран покупателя: светлая тема, «как воздух».
// Главный экран: отделы одной строкой, вписаны в ширину экрана (поля 8 px,
// зазоры 8 px); меньше отделов — колонки шире, больше пяти — плитка «ЕЩЁ».
// Отдел → его товарные группы → товар; тап по товару = печать.
// Только встроенные элементы; повторители раскладываются вручную через x/y.

export struct DeptDef {
    id: string,
    name: string,
    bg: color,
    fg: color,
    bg-pressed: color,
    img: image,
    has-img: bool,
}

export struct PluTile {
    id: string,
    name: string,
    price: string,
    // Скидочная цена (по карте); "" = второй цены нет.
    card-price: string,
    has-img: bool,
    img: image,
    // Подсветка совпадения в поиске: «до / совпадение / после».
    // hl-match == "" — обычный каталог, имя рисуется целиком.
    hl-before: string,
    hl-match: string,
    hl-after: string,
}

// Строка меню настроек: имя отдела + флаги краёв списка (стрелки видны
// только там, где перемещение возможно).
export struct AdminRow {
    name: string,
    first: bool,
    last: bool,
    // Цвет плитки отдела: «Авто» или hex пресета — для подписи кнопки.
    color-label: string,
    color: color,
}

export struct MenuRow {
    label: string,
    id: string,
    admin: bool,
}

export struct NetworkField {
    label: string,
    value: string,
}

// Строка списка мастера настройки / чек-листа (экран 19).
export struct SetupRow {
    label: string,
    // 0 = ожидание (серый), 1 = активен (подсвечен), 2 = готов (галка).
    state: int,
}

// Колонка отдела: ширина = равная доля строки; скругления сглаживает рендер,
// рамка 2 px — светло-серый контур зоны нажатия.
component DeptTile inherits Rectangle {
    in property <int> idx;
    in property <length> col-w;
    in property <length> tile-h;
    in property <length> font;
    in property <DeptDef> d;
    // false — во время печати: и тап, и свайп гасятся.
    in property <bool> active: true;

    callback tapped(string);
    // Перелистывание страниц отделов свайпом (карусель).
    callback next-page;
    callback prev-page;

    width: root.col-w;
    x: 8px + self.idx * (root.col-w + 8px);
    y: 8px;
    height: root.tile-h;
    border-radius: 24px;
    border-width: 2px;
    border-color: #C9CFD7;
    background: ta.pressed ? d.bg-pressed : d.bg;

    // Зона картинки: вся плитка над полем подписи. Картинка вписывается
    // в зону целиком (image-fit: contain), по центру: широкая колонка —
    // крупная картинка, узкая — центрированная. Нет файла — светлая плашка.
    // Картинка с тем же скруглением, что у плитки/заглушки: clip в
    // Rectangle со скруглением срезает прямые углы изображения.
    if d.has-img : Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 110px - 16px;
        border-radius: 20px;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: d.img;
        }
    }
    if !d.has-img : Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 110px - 16px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.75);
    }

    Text {
        x: 8px;
        y: parent.height - 110px;
        width: parent.width - 16px;
        height: 90px;
        text: d.name;
        // Единый кегль ряда: считает бэкенд по самой длинной подписи,
        // чтобы слово всегда влезало целиком.
        font-size: root.font;
        font-weight: 700;
        color: d.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.active;
        // Свайп: горизонтальный сдвиг > 80 px листает страницу; тап — только
        // если палец почти не сместился (< 60 px), иначе клик подавляется.
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.up {
                if ta.mouse-x - ta.pressed-x < -80px {
                    root.next-page();
                } else if ta.mouse-x - ta.pressed-x > 80px {
                    root.prev-page();
                }
            }
        }
        clicked => {
            if Math.abs(ta.mouse-x - ta.pressed-x) < 60px {
                root.tapped(root.d.id);
            }
        }
    }
}

// Карточка товара: 9 колонок × 3 строки (27 на страницу), шаг 112×182.
// Квадратная картинка 100×100 сверху, название до 3 строк, цена ниже.
// Вторая цена (по карте): обычная мелко серым, карточная зелёным.
component PluCard inherits Rectangle {
    in property <int> idx;
    in property <int> cell-offset: 0;
    in property <PluTile> p;
    in property <bool> active: true;

    callback tapped;

    width: 108px;
    height: 178px;
    x: 8px + Math.mod(self.idx + self.cell-offset, 9) * 112px;
    y: 56px + Math.floor((self.idx + self.cell-offset) / 9) * 182px;
    border-radius: 12px;
    background: !root.active ? #EDEFF2 : ta.pressed ? #E4E8ED : #FFFFFF;

    // Квадратная зона картинки: 104×104, без окантовки. Нет файла —
    // светлая плашка (картинки придут из центра позже).
    Rectangle {
        x: 2px;
        y: 2px;
        width: 104px;
        height: 104px;
        border-radius: 10px;
        clip: true;
        background: #F0F2F5;
        if root.p.has-img : Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: root.p.img;
        }
    }

    Text {
        x: 3px;
        y: 108px;
        width: parent.width - 6px;
        height: 40px;
        text: root.p.name;
        font-size: 10px;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.active ? #A6ADB8 : #1A1E24;
    }

    // Цена: одна — по центру; две — столбиком: обычная серым, карточная
    // зелёным. Кегль цены меньше кегля названия.
    if root.p.card-price == "" : Text {
        x: 3px;
        y: 150px;
        width: parent.width - 6px;
        height: 24px;
        text: root.p.price;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.active ? #A6ADB8 : #1A1E24;
    }
    if root.p.card-price != "" : Text {
        x: 3px;
        y: 147px;
        width: parent.width - 6px;
        height: 12px;
        text: root.p.price;
        font-size: 9px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #A6ADB8;
    }
    if root.p.card-price != "" : Text {
        x: 3px;
        y: 158px;
        width: parent.width - 6px;
        height: 16px;
        text: root.p.card-price;
        font-size: 11px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: #2FA36B;
    }

    ta := TouchArea {
        enabled: root.active;
        clicked => { root.tapped(); }
    }
}

// Клавиша экранной клавиатуры поиска.
component KbKey inherits Rectangle {
    in property <string> key;
    in property <length> kw: 72px;
    in property <length> kx;

    callback key-tapped(string);

    x: root.kx;
    width: root.kw;
    height: 58px;
    border-radius: 12px;
    border-width: 2px;
    border-color: #C9CFD7;
    background: k-ta.pressed ? #E4E8ED : #FFFFFF;
    Text {
        text: root.key;
        font-size: 22px;
        color: #1A1E24;
    }
    k-ta := TouchArea {
        clicked => { root.key-tapped(root.key); }
    }
    // Удержание «←»/«ЗАБОЙ» = автозабой: 250 мс и далее по такту, пока
    // палец на клавише (клавиатуры сети и поиска называют ключ по-разному).
    // Отпускание останавливает таймер (running = pressed).
    Timer {
        interval: 250ms;
        running: k-ta.pressed && (root.key == "←" || root.key == "ЗАБОЙ");
        triggered => { root.key-tapped("ЗАБОЙ"); }
    }
}

export component MainWindow inherits Window {
    title: "ScaleFW";
    // Размер экрана задаёт бэкенд (смена панели — без правки разметки).
    in property <length> screen-w: 1024px;
    in property <length> screen-h: 768px;
    width: screen-w;
    height: screen-h;
    background: #F6F7F9;
    default-font-family: "DejaVu Sans";

    // ---- данные от бэкенда ----
    in property <string> weight-text: "0.000";
    // 0 пусто, 1 нестабилен, 2 стабилен
    in property <int> weight-state: 0;
    // Связь с весовым модулем: опросный поток отдаёт данные.
    in property <bool> scales-ok: false;
    // Принтер не отвечает/офлайн (фоновый опрос статуса).
    in property <bool> printer-fault: false;
    // Этикет-лента: 0 в норме, 1 заканчивается, 2 закончилась.
    in property <int> paper-state: 0;
    // Модальная блокировка «лента закончилась»: закрывается сама, когда
    // фоновый опрос снова отвечает (заправка + протяжка выполнены).
    in property <bool> paper-popup-open: false;
    in property <bool> printer-power-hint: false;
    // В выходном лотке лежит напечатанная этикетка (датчик лотка).
    in property <bool> label-waiting: false;
    // 0 покой, 1 ожидание стабилизации, 2 печать, 3 готово, 4 ошибка принтера
    in property <int> phase: 0;
    in property <string> status-text: "";
    in property <int> status-level: 0; // 0 норма, 1 внимание, 2 ошибка
    // 0 отделы, 1 группы отдела, 2 товары группы, 4 настройки отделов
    in property <int> screen: 0;
    in property <string> screen-title: "";
    // Пейджинг отделов: страницы по колонкам, кнопка перелистывания —
    // под колонками, по центру.
    in property <int> page-no: 0;
    in property <int> pages-total: 1;
    // Пейджинг товаров группы: страницы по 10 карточек (5×2).
    in property <int> items-page-no: 0;
    // Сдвиг сетки карточек: на страницах, кроме первой, ячейка 0 занята
    // кнопкой «← НАЗАД», товары начинаются с ячейки 1.
    in property <int> items-cell-offset: 0;
    in property <int> items-pages-total: 1;
    // Страницы отделов в шапке экрана товаров: видимость «НАЗАД»/«ДАЛЕЕ».
    in property <int> dept-pages-total: 1;

    // Детальная карточка товара: оверлей поверх сетки товаров. Крупная
    // картинка, цены, живой вес и стоимость текущего веса (обычная и по
    // карте). Клик вне панели закрывает.
    in property <PluTile> popup-plu;
    in property <bool> popup-open: false;
    in property <string> popup-weight;
    in property <string> popup-sum;
    in property <string> popup-card-sum;
    in property <bool> popup-empty: true;
    // Вес на платформе есть, но ниже минимального веса печати.
    in property <bool> popup-under-min: false;
    callback plu-confirm();
    callback plu-cancel();
    in property <length> dept-font: 30px; // единый кегль подписи отдела
    // Логотип компании: зона справа от блока веса. Файл <img_dir>/logo.png
    // подкинули — картинка (вписана в зону), нет — пустое место.
    in property <image> logo-img;
    in property <bool> logo-has: false;
    in property <length> col-w: 195px; // ширина колонки (считает бэкенд)
    in property <length> tile-h: 592px; // высота колонки
    in property <[DeptDef]> depts;         // отделы текущей страницы
    in property <[DeptDef]> header-depts;  // отделы в шапке экрана товаров
    in property <[PluTile]> items;        // карточки товаров отдела, до 10

    callback dept-tapped(string);
    callback plu-tapped(string);
    callback more();
    callback back();
    // Промотка отделов в шапке экрана товаров.
    callback dept-next();
    callback dept-prev();
    // Выход на уровень выше: товары → отделы (кнопка в шапке).
    callback up();
    // Тап по индикатору веса: 5 подряд за 3 с открывают меню настроек.
    callback admin-tap();

    // Поиск (экран 3): открытие зоны поиска, нажатие клавиши, сброс.
    callback search-open();
    callback key-tapped(string);
    callback search-clear();
    in property <string> search-text;
    property <[string]> kb1: ["й","ц","у","к","е","н","г","ш","щ","з","х","ъ"];
    property <[string]> kb2: ["ф","ы","в","а","п","р","о","л","д","ж","э"];
    property <[string]> kb3: ["я","ч","с","м","и","т","ь","б","ю"];
    // Четвёртый ряд: цифры, дефис и Ё — названия вида «ЧАЙ 100 ГР» и
    // «ИЗЮМ С КОСТОЧКОЙ» ищутся по буквам и цифрам.
    property <[string]> kb4: ["1","2","3","4","5","6","7","8","9","0","-","ё"];

    property <bool> can-tap: phase != 2 && phase != 3 && phase != 4;

    // Скрытый вход в настройки: 5 быстрых тапов по полосе статуса.
    // Распознаёт бэкенд (5 тапов за 3 с), тапы ловит полоса.

    // ---- меню настроек (экраны 4-7, оверлей поверх каталога) ----
    // Экран: 4 = редактор отделов, 5 = вход по паролю, 6 = меню, 7 = диагностика.
    in property <[AdminRow]> admin-rows;
    // Маска введённого пароля (точки), чистит бэкенд.
    in property <string> pin-mask;
    // Смена пароля (экран 10): подсказка этапа и текст ошибки.
    in property <string> pin-prompt: "Введите старый пароль";
    in property <string> pin-error;
    // Заводской пароль: «НАЗАД» скрыт, смена обязательна.
    in property <bool> pin-forced: false;
    // Остаток паузы после перебора, с; 0 — ввод разрешён.
    in property <int> lock-left;
    // Роль вошедшего: 1 = администратор (полный доступ), 0 = персонал.
    in property <int> role: 0;

    callback pin-digit(string);
    callback pin-clear();
    callback pin-back();
    callback pin-try();
    // Пункт «Настройки весов»: редактор отделов.
    // Из редактора отделов назад в меню.
    callback depts-close();
    // Полный выход: назад к каталогу, вход по паролю заново.
    callback admin-close();
    callback admin-up(string);
    callback admin-down(string);
    callback admin-del(string);
    callback admin-color(string);
    // Пункт меню (id из MenuRow): диспетчеризация в бэкенде.
    callback menu-tap(string);

    // ---- мастер настройки / чек-лист (экран 19) ----
    // mode: 0 = чек-лист (живые галки, кнопка ввода в эксплуатацию),
    // 1 = мастер (пошагово). stage — шаг мастера 1..8, mask — битмаск
    // чек-листа (setup::evaluate).
    in property <int> setup-mode;
    in property <int> setup-stage;
    in property <int> setup-mask;
    // Контент активного шага: подсказка оператору.
    in property <string> setup-note;
    // Главная кнопка шага («ПЕЧАТЬ ТЕСТА», «ПРИМЕНИТЬ ВРЕМЯ», ...).
    in property <string> setup-action-label;
    in property <bool> setup-action-enabled: false;
    // Левая кнопка шага: обычно «НАЗАД», на подгонке зазора — «УЕХАЛО −16».
    in property <string> setup-back-label: "НАЗАД";
    // Кнопка «ПРОПУСТИТЬ» (подпись меняется: на шаге 5 — «ГОТОВО»,
    // на шаге 7 — состояние NTP).
    in property <bool> setup-skip-visible: false;
    in property <string> setup-skip-label: "ПРОПУСТИТЬ";
    // Отдельная кнопка «ДАЛЕЕ» (шаг 7: время и NTP — два разных действия).
    in property <bool> setup-next-visible: false;
    // Пункт «Мастер настройки» в меню виден, пока весы не введены в эксплуатацию.
    in property <bool> setup-menu-visible: false;
    callback setup-tap(string);

    // Экран «Сеть»: поля IP/маска/шлюз/DNS, тап по полю = фокус,
    // клавиатура цифр и точек, ПРИМЕНИТЬ живо меняет адрес.
    in property <[NetworkField]> net-rows;
    in property <int> net-focus;
    // Итог применения сети: модальное окно с сообщением и кнопкой ОК.
    in property <string> net-popup-text;
    in property <bool> net-popup-ok: true;
    in property <bool> net-popup-open;
    callback net-popup-close();
    // Режим главного адреса: false — ручной, true — DHCP (поля только чтение).
    in property <bool> net-dhcp;

    // ---------- Настройки весов (экраны 12–17) ----------
    // Товары и экран: колонки, сортировка. Торговые правила: округление,
    // минимальный вес. Значения ставит бэкенд при открытии экрана.
    in property <string> goods-cols: "2";
    in property <string> goods-sort: "по алфавиту";
    in property <string> goods-idle: "30 с";
    in property <string> trade-rounding: "выкл";
    in property <string> trade-minw: "10 г";
    // Импорт: список файлов каталога, подтверждение применения, результат.
    in property <[string]> imp-files;
    in property <bool> imp-popup-open: false;
    in property <bool> imp-confirm: false;
    in property <string> imp-popup-text;
    in property <bool> imp-popup-ok: true;
    callback import-tap(string);
    callback import-apply();
    callback imp-popup-close();
    // Отчёты: текст собирается в фоне.
    in property <string> report-text;
    in property <string> report-period: "Сегодня";
    in property <string> report-kind: "Все события";
    in property <string> prn-diag-text: "Идёт опрос принтера…";
    // Данные сети заполнены и корректны — кнопка ПРИМЕНИТЬ активна.
    in property <bool> net-valid: false;
    callback net-mode(bool);
    callback net-tap(int);
    callback net-key(string);
    callback net-apply();
    // IP весов в углу экрана входа по паролю (для персонала).
    in property <string> ip-note;
    // Отчёт диагностики (экран 7).
    in property <string> diag-text;

    // ---------- A. статус = индикатор исправности ----------
    // Вся полоса — сводное состояние кассы: светло-зелёная — всё работает;
    // персиковая — расходник (этикет-лента); ярко-красная — критично
    // (нет связи с весовым модулем или принтер не отвечает).
    // Текст в полосе — активное сообщение печати либо причина цвета.
    Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: 20px;
        background: root.printer-fault || !root.scales-ok || status-level == 2 ? #E23B3B
                  : root.paper-state != 0 ? #F6D9A0
                  : root.label-waiting ? #F6D9A0
                  : status-level == 1 ? #F5E3BC : #D8EEDF;
        Text {
            x: 16px;
            width: 992px;
            height: 20px;
                        text: root.status-text != "" ? root.status-text
                : !root.scales-ok ? "Ошибка весов. Позовите сотрудника"
                : root.printer-fault ? "Ошибка печати. Позовите сотрудника"
                : root.label-waiting ? "Уберите этикетку из лотка"
                : root.paper-state == 2 ? "Лента закончилась. Позовите сотрудника"
                : root.paper-state == 1 ? "Лента заканчивается" : "";
            font-size: 13px;
            vertical-alignment: center;
            color: root.printer-fault || !root.scales-ok || status-level == 2 ? #FFFFFF
                 : root.paper-state != 0 || status-level == 1 ? #6B4A1B : #4E8A67;
        }
    }

    // ---------- B1. вес ----------
    // Скрытый вход в настройки: 5 быстрых тапов по индикатору веса
    // (за 3 с после первого). Обрабатывает бэкенд, здесь только счёт.
    admin-tap-zone := TouchArea {
        x: 0;
        y: 24px;
        width: 420px;
        height: 152px;
        enabled: root.screen == 0 || root.screen == 2;
        clicked => { root.admin-tap(); }
    }
    Text {
        x: 16px; y: 44px;
        width: 380px;
        height: 112px;
        text: root.weight-text;
        font-size: 96px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: weight-state == 0 ? #A6ADB8
             : weight-state == 1 ? #C77700 : #1A1E24;
    }
    Text {
        x: 404px; y: 96px;
        text: "кг";
        font-size: 32px;
        color: weight-state == 0 ? #A6ADB8 : #707A86;
    }
    // Индикатор стабильности: линия под весом во всю ширину экрана,
    // скруглённая на концах. Зелёная — можно брать товар, янтарная — ждём.
    if weight-state == 1 || weight-state == 2 : Rectangle {
        // Линия на ширину весового блока (вес + «кг»), не всего экрана.
        x: 16px;
        y: 150px;
        width: 444px;
        height: 6px;
        border-radius: 3px;
        background: weight-state == 2 ? #2FA36B : #E0A100;
    }

    // Логотип компании: невидимая зона справа от блока веса. Пропорция зоны
    // равна пропорции logo.png (480x88): ширина всей полосы, высота по ней.
    // Нет файла — пустое место.
    property <length> logo-h: (root.width - 496px) * (88px / 480px);
    if root.logo-has : Rectangle {
        x: 480px;
        y: 44px + (112px - root.logo-h) / 2;
        width: root.width - 496px;
        height: root.logo-h;
        Image {
            width: 100%;
            height: 100%;
            image-fit: fill;
            source: root.logo-img;
        }
    }

    // ---------- C. главный экран: отделы одной строкой ----------
    if screen == 0 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;

        for d[i] in root.depts : DeptTile {
            idx: i;
            col-w: root.col-w;
            tile-h: root.tile-h;
            font: root.dept-font;
            d: d;
            active: root.can-tap;
            tapped(dept) => { root.dept-tapped(dept); }
            next-page => { root.more(); }
            prev-page => { root.back(); }
        }
    }

    // ---------- C. пейджер: под колонками отделов, с отступом ----------
    // Экран 0 — страницы отделов; на экране товаров «ДАЛЕЕ» — плитка в гриде.
    if screen == 0 && pages-total > 1 : Rectangle {
        y: 160px + root.tile-h + 16px;
        x: 0;
        width: root.width;
        height: 56px;
        if page-no > 0 : Rectangle {
            x: 16px;
            y: 0;
            width: 200px;
            height: 56px;
            border-radius: 16px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: pager-back-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "← НАЗАД";
                font-size: 24px;
                font-weight: 700;
                color: #4A5460;
            }
            pager-back-ta := TouchArea {
                clicked => { root.back(); }
            }
        }
        if page-no < pages-total - 1 : Rectangle {
            x: root.width - 216px;
            y: 0;
            width: 200px;
            height: 56px;
            border-radius: 16px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: pager-more-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "ДАЛЕЕ →";
                font-size: 24px;
                font-weight: 700;
                color: #4A5460;
            }
            pager-more-ta := TouchArea {
                clicked => { root.more(); }
            }
        }
    }

    // ---------- C. товары отдела ----------
    if screen == 2 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;

        // Кнопки отделов в шапке: столько же, сколько колонок на главном.
        // Текущий отдел подсвечен; сверх колонок — кнопка промотки.
        for d[i] in root.header-depts : Rectangle {
            x: 8px + i * 114px;
            y: 8px;
            width: 110px;
            height: 40px;
            border-radius: 12px;
            background: d.name == root.screen-title ? #DDE3EA
                     : hd-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                text: d.name;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #1A1E24;
            }
            hd-ta := TouchArea {
                clicked => { root.dept-tapped(d.name); }
            }
        }
        // «НАЗАД» — только когда промотка уже делалась.
        if root.page-no > 0 : Rectangle {
            x: 8px + root.header-depts.length * 114px;
            y: 8px;
            width: 62px;
            height: 40px;
            border-radius: 12px;
            background: dept-prev-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "НАЗАД";
                font-size: 13px;
                font-weight: 700;
                color: #4A5460;
            }
            dept-prev-ta := TouchArea {
                clicked => { root.dept-prev(); }
            }
        }
        // «ДАЛЕЕ» — только если есть следующая порция отделов.
        if root.page-no < root.dept-pages-total - 1 : Rectangle {
            x: 8px + root.header-depts.length * 114px
                + (root.page-no > 0 ? 66px : 0px);
            y: 8px;
            width: 62px;
            height: 40px;
            border-radius: 12px;
            background: dept-next-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "ДАЛЕЕ";
                font-size: 13px;
                font-weight: 700;
                color: #4A5460;
            }
            dept-next-ta := TouchArea {
                clicked => { root.dept-next(); }
            }
        }
        // Поиск доступен отовсюду: пилюля в шапке экрана товаров.
        Rectangle {
            x: root.width - 308px; y: 8px;
            width: 300px; height: 40px;
            border-radius: 12px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: search2-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                text: "Поиск товара";
                font-size: 16px;
                color: #A6ADB8;
                vertical-alignment: center;
            }
            search2-ta := TouchArea {
                clicked => { root.search-open(); }
            }
        }
        // «← НАЗАД» — ячейка 0 на всех страницах, кроме первой.
        if root.items-page-no > 0 : Rectangle {
            x: 8px;
            y: 56px;
            width: 108px;
            height: 178px;
            border-radius: 12px;
            background: prev2-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "← НАЗАД";
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: #4A5460;
            }
            prev2-ta := TouchArea {
                clicked => { root.back(); }
            }
        }
        for p[i] in root.items : PluCard {
            idx: i;
            cell-offset: root.items-cell-offset;
            p: p;
            active: root.can-tap;
            tapped => { root.plu-tapped(p.id); }
        }
        // «ДАЛЕЕ →» — ячейка сразу за последним товаром (на полной странице
        // — последняя ячейка сетки), как в оригинальном ПО.
        if root.items-page-no < root.items-pages-total - 1 : Rectangle {
            x: 8px + Math.mod(root.items.length + root.items-cell-offset, 9) * 112px;
            y: 56px + Math.floor((root.items.length + root.items-cell-offset) / 9) * 182px;
            width: 108px;
            height: 178px;
            border-radius: 12px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: next2-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "ДАЛЕЕ →";
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: #4A5460;
            }
            next2-ta := TouchArea {
                clicked => { root.more(); }
            }
        }
    }

    // ---------- C. зона поиска: внизу, между «← НАЗАД» и «ДАЛЕЕ →» ----------
    // Тап открывает экран поиска (3): клавиатура + живая выдача.
    if screen == 0 : Rectangle {
        x: root.width / 2 - 200px;
        y: 160px + root.tile-h + 16px;
        width: 400px;
        height: 56px;
        border-radius: 16px;
        border-width: 2px;
        border-color: #C9CFD7;
        background: search-ta.pressed ? #E4E8ED : #FFFFFF;
        Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text: "Поиск товара";
            font-size: 24px;
            color: #A6ADB8;
            vertical-alignment: center;
        }
        search-ta := TouchArea {
            clicked => { root.search-open(); }
        }
    }

    // ---------- C. поиск: строка ввода, выдача, клавиатура (экран 3) ----------
    if screen == 3 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;

        // Шапка: «← Назад», поле ввода, «ОЧИСТИТЬ».
        Rectangle {
            x: 8px; y: 8px;
            width: 180px; height: 56px;
            border-radius: 16px;
            background: search-back-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "← Назад";
                font-size: 24px;
                font-weight: 700;
                color: #1A1E24;
            }
            search-back-ta := TouchArea {
                clicked => { root.up(); }
            }
        }
        Rectangle {
            x: 204px; y: 8px;
            width: 620px; height: 56px;
            border-radius: 16px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: #FFFFFF;
            Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: root.search-text == "" ? "Введите название…" : root.search-text;
                font-size: 22px;
                color: root.search-text == "" ? #A6ADB8 : #1A1E24;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: 840px; y: 8px;
            width: 176px; height: 56px;
            border-radius: 16px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: search-clear-ta.pressed ? #E4E8ED : #FFFFFF;
            Text {
                text: "ОЧИСТИТЬ";
                font-size: 20px;
                font-weight: 700;
                color: #4A5460;
            }
            search-clear-ta := TouchArea {
                clicked => { root.search-clear(); }
            }
        }

        // Выдача: до 5 строк «название — цены». Совпадение подсвечено.
        for p[i] in root.items : Rectangle {
            x: 8px;
            y: 72px + i * 64px;
            width: 1008px;
            height: 56px;
            border-radius: 12px;
            background: res-ta.pressed ? #E4E8ED : #FFFFFF;
            if p.hl-match == "" : Text {
                x: 16px;
                width: 560px;
                height: parent.height;
                text: p.name;
                font-size: 20px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
                color: #1A1E24;
            }
            if p.hl-match != "" : HorizontalLayout {
                x: 16px;
                width: 560px;
                height: parent.height;
                Text {
                    text: p.hl-before;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                    color: #1A1E24;
                }
                Text {
                    text: p.hl-match;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: #2F6FED;
                }
                Text {
                    text: p.hl-after;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: #1A1E24;
                }
            }
            Text {
                x: 584px;
                width: 190px;
                height: parent.height;
                text: p.price;
                font-size: 18px;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: p.card-price == "" ? #1A1E24 : #A6ADB8;
            }
            if p.card-price != "" : Text {
                x: 790px;
                width: 190px;
                height: parent.height;
                text: p.card-price;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: #2FA36B;
            }
            res-ta := TouchArea {
                clicked => { root.plu-tapped(p.id); }
            }
        }
        if root.items.length == 0 && root.search-text == "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Начните вводить название товара";
            font-size: 22px;
            horizontal-alignment: center;
            color: #A6ADB8;
        }
        if root.items.length == 0 && root.search-text != "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Ничего не найдено";
            font-size: 22px;
            horizontal-alignment: center;
            color: #A6ADB8;
        }

        // Клавиатура: ЙЦУКЕН, пробел, забой.
        for k[i] in root.kb1 : KbKey {
            kx: 8px + i * 78px;
            y: 404px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb2 : KbKey {
            kx: 82px + i * 78px;
            y: 470px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb3 : KbKey {
            kx: 8px + i * 78px;
            y: 536px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 712px;
            y: 536px;
            kw: 170px;
            key: "ПРОБЕЛ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 890px;
            y: 536px;
            kw: 118px;
            key: "ЗАБОЙ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb4 : KbKey {
            kx: 8px + i * 78px;
            y: 602px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
    }

    // ---------- E. детальная карточка товара: оверлей поверх сетки ----------
    if root.popup-open : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: transparent;
        // Клик мимо панели закрывает карточку.
        popup-back-ta := TouchArea {
            clicked => { root.plu-cancel(); }
        }

        Rectangle {
            x: 152px; y: 150px;
            width: 720px; height: 468px;
            border-radius: 24px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: #FFFFFF;
            // Панель глушит клики (закрытие — только мимо панели/«ОТМЕНА»).
            popup-panel-ta := TouchArea { }

            // Картинка крупно.
            Rectangle {
                x: 24px; y: 24px;
                width: 280px; height: 280px;
                border-radius: 16px;
                clip: true;
                background: #F0F2F5;
                if root.popup-plu.has-img : Image {
                    width: 100%;
                    height: 100%;
                    image-fit: cover;
                    source: root.popup-plu.img;
                }
            }

            // Название и цены за килограмм.
            Text {
                x: 328px; y: 24px;
                width: 368px; height: 64px;
                text: root.popup-plu.name;
                font-size: 22px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
                color: #1A1E24;
            }
            Text {
                x: 328px; y: 100px;
                width: 368px; height: 32px;
                text: "Цена: " + root.popup-plu.price;
                font-size: 22px;
                vertical-alignment: center;
                color: #1A1E24;
            }
            if root.popup-plu.card-price != "" : Text {
                x: 328px; y: 136px;
                width: 368px; height: 32px;
                text: "По скидочной карте: " + root.popup-plu.card-price;
                font-size: 18px;
                font-weight: 700;
                vertical-alignment: center;
                color: #2FA36B;
            }

            // Вес и стоимость текущего веса; на пустых весах — подсказка.
            if !root.popup-empty : Text {
                x: 24px; y: 312px;
                width: 300px; height: 72px;
                text: root.popup-weight;
                font-size: 40px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: #1A1E24;
            }
            if !root.popup-empty : Text {
                x: 328px; y: 316px;
                width: 368px; height: 32px;
                text: "Итого: " + root.popup-sum;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
                color: #1A1E24;
            }
            if !root.popup-empty && root.popup-plu.card-price != "" : Text {
                x: 328px; y: 352px;
                width: 368px; height: 32px;
                text: "Со скидочной картой: " + root.popup-card-sum;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                color: #2FA36B;
            }
            if root.popup-empty : Text {
                x: 24px; y: 320px;
                width: 672px; height: 56px;
                text: root.popup-under-min ? "Вес слишком мал" : "Положите товар на весы";
                font-size: 24px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.popup-under-min ? #B3261E : #707A86;
            }
            // Скрытый вход в настройки доступен и из карточки: тапы по
            // зоне веса считаются той же серией (кнопки ниже не задеты).
            admin-pop-zone := TouchArea {
                x: 24px; y: 300px;
                width: 300px; height: 88px;
                clicked => { root.admin-tap(); }
            }

            // Кнопки: отмена и переход к печати.
            Rectangle {
                x: 24px; y: 392px;
                width: 200px; height: 56px;
                border-radius: 16px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: popup-cancel-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    text: "ОТМЕНА";
                    font-size: 22px;
                    font-weight: 700;
                    color: #4A5460;
                }
                popup-cancel-ta := TouchArea {
                    clicked => { root.plu-cancel(); }
                }
            }
            Rectangle {
                x: 496px; y: 392px;
                width: 200px; height: 56px;
                border-radius: 16px;
                // Печать доступна только при стабильном весе: без товара
                // и на дрожащей платформе кнопка гаснет.
                background: !popup-ok-ta.enabled ? #C9CFD7
                         : popup-ok-ta.pressed ? #268A5A : #2FA36B;
                Text {
                    text: "ПЕЧАТЬ";
                    font-size: 22px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                popup-ok-ta := TouchArea {
                    enabled: !root.popup-empty && root.weight-state == 2;
                    clicked => { root.plu-confirm(); }
                }
            }
        }
    }

    // ---------- Модальное окно «лента закончилась» ----------
    // Верхний уровень окна (вне экранов и админ-оверлея), иначе не видно
    // на покупательских экранах. Показ при fault (screen <= 3): тапы не
    // проходят сквозь. Уходит сам после заправки и перезагрузки весов
    // (опрос статуса снова отвечает).
    if root.paper-popup-open && root.screen <= 3 : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: rgba(10, 14, 20, 0.6);
        paper-popup-ta := TouchArea { }
        Rectangle {
            x: (root.width - 640px) / 2;
            y: (root.height - 330px) / 2;
            width: 640px;
            height: 330px;
            border-radius: 18px;
            background: #FFFFFF;
            Text {
                x: 32px;
                y: 30px;
                width: parent.width - 64px;
                text: "Закончилась бумага в принтере";
                font-size: 30px;
                font-weight: 700;
                color: #C0392B;
            }
            Text {
                x: 32px;
                y: 110px;
                width: parent.width - 64px;
                text: root.printer-power-hint
                    ? "Принтер не восстановился автоматически.\nВыключите и включите питание принтера.\nЕсли проблема повторяется — обратитесь в сервис."
                    : "Проверьте ленту в принтере и перезаправьте, если нужно.\nЗатем выключите весы на несколько секунд и включите обратно.";
                font-size: 22px;
                color: #2B2F36;
                wrap: word-wrap;
            }
        }
    }

    // ---------- B2. уведомления — только верхняя строка (нейтральные) ----------
    // Центральных всплывашек нет: покупатель может перекладывать товар и
    // листать каталог одновременно.

    // ---------- Меню настроек: оверлей поверх каталога ----------
    // Одно окно: вход по паролю, меню, редактор отделов и диагностика —
    // экраны главного окна (второе X-окно на этом железе с winit 0.30 без
    // WM нестабильно по размеру). Полноэкранный прямоугольник + гасящий
    // TouchArea: клики каталога под оверлеем не проходят.
    if root.screen >= 4 : Rectangle {
        x: 0; y: 0;
        width: root.screen-w;
        height: root.screen-h;
        background: #F6F7F9;
        admin-block-ta := TouchArea { }

        // Шапка: заголовок по экрану, справа «НАЗАД» (редактор) и «ГОТОВО»/«ВЫХОД».
        Rectangle {
            x: 8px; y: 8px;
            width: parent.width - 16px;
            height: 64px;
            border-radius: 16px;
            border-width: 2px;
            border-color: #C9CFD7;
            background: #FFFFFF;
            Text {
                x: 16px;
                width: parent.width - 440px;
                height: parent.height;
                text: root.screen == 5 ? "ВХОД ПЕРСОНАЛА"
                    : root.screen == 4 ? "НАСТРОЙКИ · ОТДЕЛЫ"
                    : root.screen == 7 ? "ДИАГНОСТИКА"
                    : root.screen == 8 ? "НАСТРОЙКИ · СЕТЬ"
                    : root.screen == 9 ? "НАСТРОЙКИ · ОБОРУДОВАНИЕ"
                    : root.screen == 10 ? "СМЕНА ПАРОЛЯ"
                    : root.screen == 12 ? "НАСТРОЙКИ ВЕСОВ"
                    : root.screen == 13 ? "НАСТРОЙКИ · ТОВАРЫ И ЭКРАН"
                    : root.screen == 14 ? "НАСТРОЙКИ · ТОРГОВЫЕ ПРАВИЛА"
                    : root.screen == 15 ? "НАСТРОЙКИ · ОБСЛУЖИВАНИЕ"
                    : root.screen == 16 ? "НАСТРОЙКИ · ИМПОРТ"
                    : root.screen == 17 ? "ОТЧЁТЫ"
                    : root.screen == 18 ? "ПРИНТЕР · ДИАГНОСТИКА"
                    : root.screen == 19 ? "НАСТРОЙКА ВЕСОВ"
                    : "МЕНЮ НАСТРОЕК";
                font-size: 26px;
                font-weight: 700;
                color: #1A1E24;
                vertical-alignment: center;
                overflow: elide;
            }
            if (root.screen == 4 || root.screen == 8 || root.screen == 9
                || root.screen == 12 || root.screen == 13
                || root.screen == 14 || root.screen == 16 || root.screen == 17
                || root.screen == 18)
                && !root.pin-forced : Rectangle {
                x: parent.width - 336px;
                y: 8px;
                width: 160px;
                height: 48px;
                border-radius: 12px;
                background: admin-back-ta.pressed ? #E4E8ED : #EDF0F3;
                Text {
                    text: "НАЗАД";
                    font-size: 24px;
                    font-weight: 700;
                    color: #1A1E24;
                }
                admin-back-ta := TouchArea {
                    clicked => { root.depts-close(); }
                }
            }
            // «ВЫХОД» скрыт в мастере настройки (экран 19): выход в каталог
            // при пустой таблице пользователей = софт-лок, вход в меню
            // возможен только после создания PIN-ов.
            if root.screen != 19 : Rectangle {
                x: parent.width - 176px;
                y: 8px;
                width: 160px;
                height: 48px;
                border-radius: 12px;
                background: admin-done-ta.pressed ? #E4E8ED : #EDF0F3;
                Text {
                    text: root.screen == 4 ? "ГОТОВО" : "ВЫХОД";
                    font-size: 24px;
                    font-weight: 700;
                    color: #1A1E24;
                }
                admin-done-ta := TouchArea {
                    clicked => { root.admin-close(); }
                }
            }
        }

        // ---------- Экран 10: смена пароля ----------
        // Тот же пин-пад, что и на входе; подсказка этапа — pin-prompt.
        if root.screen == 10 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            Text {
                x: 0; y: 8px;
                width: parent.width;
                height: 32px;
                text: root.pin-prompt;
                font-size: 26px;
                font-weight: 700;
                color: #1A1E24;
                horizontal-alignment: center;
            }
            Rectangle {
                x: 262px;
                y: 44px;
                width: 500px;
                height: 64px;
                border-radius: 14px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                Text {
                    text: root.pin-mask == "" ? "пароль" : root.pin-mask;
                    font-size: 34px;
                    font-weight: 700;
                    color: root.pin-mask == "" ? #A6ADB8 : #1A1E24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pin-error != "" : Text {
                x: 0; y: 112px;
                width: parent.width;
                height: 32px;
                text: root.pin-error;
                font-size: 22px;
                font-weight: 700;
                color: #B3261E;
                horizontal-alignment: center;
            }

            property <[string]> keys: ["1","2","3","4","5","6","7","8","9","C","0","←"];
            for k[i] in keys : Rectangle {
                x: 262px + mod(i, 3) * 170px;
                y: 152px + floor(i / 3) * 100px;
                width: 160px;
                height: 92px;
                border-radius: 14px;
                background: kb2-ta.pressed ? #DDE3EA : #FFFFFF;
                border-width: 2px;
                border-color: #C9CFD7;
                Text {
                    text: k;
                    font-size: 40px;
                    font-weight: 700;
                    color: #1A1E24;
                }
                kb2-ta := TouchArea {
                    clicked => {
                        k == "C" ? root.pin-clear()
                        : k == "←" ? root.pin-back()
                        : root.pin-digit(k);
                    }
                }
            }

            Rectangle {
                x: 262px;
                y: 608px;
                width: 500px;
                height: 64px;
                border-radius: 14px;
                background: root.pin-mask == ""
                    ? #DDE1E6
                    : (pin-save-ta.pressed ? #1E4D3A : #2E7D57);
                Text {
                    text: "ДАЛЕЕ";
                    font-size: 28px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                pin-save-ta := TouchArea {
                    enabled: root.pin-mask != "";
                    clicked => { root.pin-try(); }
                }
            }
        }

        // ---------- Экран 19: мастер настройки / чек-лист ----------
        // Разметка под 800×480: слева список шагов (компактные строки),
        // справа контент шага и два ряда кнопок. Ширины заданы так, чтобы
        // ряды не пересекались при любой видимости кнопок.
        if root.screen == 19 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[SetupRow]> wizard-rows: [
                { label: "1 · Пароль администратора", state: root.setup-stage > 1 ? 2 : (root.setup-stage == 1 ? 1 : 0) },
                { label: "2 · Пароль кассира", state: root.setup-stage > 2 ? 2 : (root.setup-stage == 2 ? 1 : 0) },
                { label: "3 · Сеть", state: root.setup-stage > 3 ? 2 : (root.setup-stage == 3 ? 1 : 0) },
                { label: "4 · Проверка весов", state: root.setup-stage > 4 ? 2 : (root.setup-stage == 4 ? 1 : 0) },
                { label: "5 · Печать (тест)", state: root.setup-stage > 5 ? 2 : (root.setup-stage == 5 ? 1 : 0) },
                { label: "6 · Длина этикетки", state: root.setup-stage > 6 ? 2 : (root.setup-stage == 6 ? 1 : 0) },
                { label: "7 · Дата и время", state: root.setup-stage > 7 ? 2 : (root.setup-stage == 7 ? 1 : 0) },
                { label: "8 · Готово", state: root.setup-stage > 8 ? 2 : (root.setup-stage == 8 ? 1 : 0) },
            ];
            // Slint не имеет битовых операций: биты маски через mod/floor.
            property <int> bit-goods: mod(root.setup-mask, 2);
            property <int> bit-layout: mod(floor(root.setup-mask / 2), 2);
            property <int> bit-printer: mod(floor(root.setup-mask / 4), 2);
            property <int> bit-scales: mod(floor(root.setup-mask / 8), 2);
            property <[SetupRow]> checklist-rows: [
                { label: "Товары загружены", state: bit-goods == 1 ? 2 : 1 },
                { label: "Раскладка этикетки", state: bit-layout == 1 ? 2 : 1 },
                { label: "Принтер исправен", state: bit-printer == 1 ? 2 : 1 },
                { label: "Весы исправны", state: bit-scales == 1 ? 2 : 1 },
            ];

            // Список шагов: 8 строк по 42px + зазор 6 — влезает в высоту.
            for row[i] in (root.setup-mode == 1 ? wizard-rows : checklist-rows) : Rectangle {
                x: 8px;
                y: 6px + i * 48px;
                width: 300px;
                height: 42px;
                border-radius: 10px;
                border-width: 2px;
                border-color: row.state == 1 ? #2E7D57 : #C9CFD7;
                background: row.state == 1 ? #F0F7F2 : #FFFFFF;
                Text {
                    x: 12px;
                    width: parent.width - 40px;
                    height: parent.height;
                    text: row.label;
                    font-size: 18px;
                    font-weight: row.state == 1 ? 700 : 500;
                    color: row.state == 0 ? #A6ADB8 : (row.state == 1 ? #1A1E24 : #2E7D57);
                    vertical-alignment: center;
                    overflow: elide;
                }
                if row.state == 2 : Text {
                    x: parent.width - 34px;
                    width: 26px;
                    height: parent.height;
                    text: "✓";
                    font-size: 22px;
                    font-weight: 700;
                    color: #2E7D57;
                    vertical-alignment: center;
                }
            }

            // Контент активного шага.
            Rectangle {
                x: 320px;
                y: 6px;
                width: parent.width - 328px;
                height: parent.height - 170px;
                border-radius: 14px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: parent.height - 24px;
                    text: root.setup-note;
                    font-size: 19px;
                    color: #2B2F36;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }

            // Ряд 1: назад + главная кнопка шага.
            Rectangle {
                x: 320px;
                y: parent.height - 156px;
                width: 150px;
                height: 68px;
                border-radius: 12px;
                background: setup-back-ta.pressed ? #E4E8ED : #EDF0F3;
                Text {
                    text: root.setup-back-label;
                    font-size: 18px;
                    font-weight: 700;
                    color: #1A1E24;
                    overflow: elide;
                }
                setup-back-ta := TouchArea {
                    clicked => { root.setup-tap("back"); }
                }
            }
            Rectangle {
                x: 482px;
                y: parent.height - 156px;
                width: parent.width - 490px;
                height: 68px;
                border-radius: 12px;
                background: !root.setup-action-enabled ? #DDE1E6
                    : (setup-action-ta.pressed ? #1E4D3A : #2E7D57);
                Text {
                    text: root.setup-action-label;
                    font-size: 19px;
                    font-weight: 700;
                    color: #FFFFFF;
                    overflow: elide;
                }
                setup-action-ta := TouchArea {
                    enabled: root.setup-action-enabled;
                    clicked => { root.setup-tap("action"); }
                }
            }

            // Ряд 2: пропуск (подпись по шагу: ПРОПУСТИТЬ / ГОТОВО / NTP)
            // и ДАЛЕЕ (только шаг 7). Позиции не пересекаются с рядом 1.
            if root.setup-skip-visible : Rectangle {
                x: 320px;
                y: parent.height - 80px;
                width: parent.width - 540px;
                height: 68px;
                border-radius: 12px;
                background: setup-skip-ta.pressed ? #E4E8ED : #EDF0F3;
                Text {
                    text: root.setup-skip-label;
                    font-size: 18px;
                    font-weight: 700;
                    color: #1A1E24;
                    overflow: elide;
                }
                setup-skip-ta := TouchArea {
                    clicked => { root.setup-tap("skip"); }
                }
            }
            if root.setup-next-visible : Rectangle {
                x: parent.width - 208px;
                y: parent.height - 80px;
                width: 200px;
                height: 68px;
                border-radius: 12px;
                background: setup-next-ta.pressed ? #1E4D3A : #2E7D57;
                Text {
                    text: "ДАЛЕЕ";
                    font-size: 20px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                setup-next-ta := TouchArea {
                    clicked => { root.setup-tap("next"); }
                }
            }
        }
        // ---------- Экран 5: вход по паролю ----------
        if root.screen == 5 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            // Маска: точка на каждую введённую цифру.
            Rectangle {
                x: 262px;
                y: 12px;
                width: 500px;
                height: 72px;
                border-radius: 14px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                Text {
                    text: root.pin-mask == "" ? "пароль" : root.pin-mask;
                    font-size: 34px;
                    font-weight: 700;
                    color: root.pin-mask == "" ? #A6ADB8 : #1A1E24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pin-error != "" : Text {
                x: 0; y: 96px;
                width: parent.width;
                height: 36px;
                text: root.pin-error;
                font-size: 24px;
                font-weight: 700;
                color: #B3261E;
                horizontal-alignment: center;
            }
            if root.lock-left > 0 : Text {
                x: 0; y: 96px;
                width: parent.width;
                height: 36px;
                text: "Слишком много попыток. Повтор через " + root.lock-left + " с";
                font-size: 24px;
                font-weight: 700;
                color: #B3261E;
                horizontal-alignment: center;
            }

            // Цифровая клавиатура: 3×4. «С» чистит поле, «←» стирает цифру.
            property <[string]> keys: ["1","2","3","4","5","6","7","8","9","C","0","←"];
            for k[i] in keys : Rectangle {
                x: 262px + mod(i, 3) * 170px;
                y: 140px + floor(i / 3) * 116px;
                width: 160px;
                height: 106px;
                border-radius: 14px;
                background: kb-ta.pressed ? #DDE3EA : #FFFFFF;
                border-width: 2px;
                border-color: #C9CFD7;
                Text {
                    text: k;
                    font-size: 40px;
                    font-weight: 700;
                    color: #1A1E24;
                }
                kb-ta := TouchArea {
                    clicked => {
                        k == "C" ? root.pin-clear()
                        : k == "←" ? root.pin-back()
                        : root.pin-digit(k);
                    }
                }
            }

            // Проверка на бэкенде; при активной паузе кнопка неактивна.
            Rectangle {
                x: 262px;
                y: 608px;
                width: 500px;
                height: 64px;
                border-radius: 14px;
                background: root.lock-left > 0 || root.pin-mask == ""
                    ? #DDE1E6
                    : (pin-ok-ta.pressed ? #1E4D3A : #2E7D57);
                Text {
                    text: "ВОЙТИ";
                    font-size: 28px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                pin-ok-ta := TouchArea {
                    enabled: root.lock-left == 0 && root.pin-mask != "";
                    clicked => { root.pin-try(); }
                }
            }

            // Адрес весов для персонала: мелко в правом нижнем углу.
            Text {
                x: parent.width - 360px;
                y: parent.height - 30px;
                width: 350px;
                height: 26px;
                text: root.ip-note;
                font-size: 18px;
                color: #7A828C;
                horizontal-alignment: right;
            }
        }

        // ---------- Экран 6: главное меню ----------
        // Обслуживание доступно персоналу, настройка — только администратору
        // (роль приходит от бэкенда после входа).
        if root.screen == 6 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            // Кассиру — только протяжка и перезагрузка (мастер настройки
            // и разделы настроек — админские). Пункт мастера виден, пока
            // весы не введены в эксплуатацию.
            property <[MenuRow]> rows-staff: [
                { label: "Протяжка этикетки", id: "feed", admin: false },
                { label: "Перезагрузка весов", id: "restart", admin: false },
            ];
            property <[MenuRow]> rows-admin-setup: [
                { label: "Мастер настройки", id: "setup", admin: false },
                { label: "Настройки весов", id: "scaleset", admin: true },
                { label: "Пароль кассира", id: "createstaff", admin: true },
                { label: "Оборудование", id: "equip", admin: false },
                { label: "Сеть", id: "net", admin: true },
                { label: "Выставить 0 / тарировать", id: "zero", admin: false },
                { label: "Перезагрузка весов", id: "restart", admin: true },
            ];
            property <[MenuRow]> rows-admin: [
                { label: "Настройки весов", id: "scaleset", admin: true },
                { label: "Пароль кассира", id: "createstaff", admin: true },
                { label: "Оборудование", id: "equip", admin: false },
                { label: "Сеть", id: "net", admin: true },
                { label: "Выставить 0 / тарировать", id: "zero", admin: false },
                { label: "Перезагрузка весов", id: "restart", admin: true },
            ];
            property <[MenuRow]> rows: root.role == 0 ? rows-staff
                : (root.setup-menu-visible ? rows-admin-setup : rows-admin);
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                // pressed видит любой нажавший: это отрисовка, а не права
                // (доступ пунктов ограничивается opacity и menu-tap).
                background: menu-ta.pressed ? #E4E8ED : #FFFFFF;
                opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: r.label + (r.admin && root.role != 1 ? " · только администратор" : "");
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                menu-ta := TouchArea {
                    clicked => {
                        (root.role == 1 || !r.admin) ? root.menu-tap(r.id) : {};
                    }
                }
            }
        }

        // ---------- Экран 7: диагностика ----------
        if root.screen == 7 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            Rectangle {
                x: 8px; y: 12px;
                width: parent.width - 16px;
                height: parent.height - 24px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                clip: true;

                Flickable {
                    x: 16px; y: 16px;
                    width: parent.width - 32px;
                    height: parent.height - 32px;
                    viewport-height: diag-t.preferred-height;
                    diag-t := Text {
                        width: parent.width;
                        text: root.diag-text;
                        font-size: 20px;
                        font-family: "monospace";
                        color: #1A1E24;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ---------- Экран 8: сеть (IP/маска/шлюз/DNS) ----------
        if root.screen == 8 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            // Переключатель режима: в DHCP поля только чтение.
            Rectangle {
                x: 8px;
                y: 12px;
                width: parent.width - 16px;
                height: 52px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                Rectangle {
                    x: 4px;
                    y: 4px;
                    width: (parent.width - 16px) / 2;
                    height: parent.height - 8px;
                    border-radius: 10px;
                    background: !root.net-dhcp ? #2F6FED : #EDF0F3;
                    Text {
                        text: "РУЧНОЙ";
                        font-size: 20px;
                        font-weight: 700;
                        color: !root.net-dhcp ? #FFFFFF : #1A1E24;
                    }
                    TouchArea { clicked => { root.net-mode(false); } }
                }
                Rectangle {
                    x: parent.width - 4px - (parent.width - 16px) / 2;
                    y: 4px;
                    width: (parent.width - 16px) / 2;
                    height: parent.height - 8px;
                    border-radius: 10px;
                    background: root.net-dhcp ? #2F6FED : #EDF0F3;
                    Text {
                        text: "DHCP";
                        font-size: 20px;
                        font-weight: 700;
                        color: root.net-dhcp ? #FFFFFF : #1A1E24;
                    }
                    TouchArea { clicked => { root.net-mode(true); } }
                }
            }

            // Поля: тап по строке — фокус (только в ручном режиме); в DHCP
            // строки серые и не нажимаются, показывают полученные значения.
            for f[i] in root.net-rows : Rectangle {
                x: 8px;
                y: 72px + i * 58px;
                width: parent.width - 16px;
                height: 52px;
                border-radius: 12px;
                border-width: 2px;
                border-color: !root.net-dhcp && root.net-focus == i ? #2F6FED : #C9CFD7;
                background: #FFFFFF;
                opacity: root.net-dhcp ? 0.55 : 1.0;
                Text {
                    x: 16px;
                    width: 140px;
                    height: parent.height;
                    text: f.label;
                    font-size: 22px;
                    font-weight: 700;
                    color: #4A5460;
                    vertical-alignment: center;
                }
                Text {
                    x: 170px;
                    width: parent.width - 186px;
                    height: parent.height;
                    text: f.value;
                    font-size: 24px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    enabled: !root.net-dhcp;
                    clicked => { root.net-tap(i); }
                }
            }

            // Клавиатура: цифры, точка, забой (три ряда) + C рядом с ПРИМЕНИТЬ.
            property <[string]> net-keys: ["7","8","9","4","5","6","1","2","3",".","0","←"];
            for k[j] in net-keys : Rectangle {
                x: 8px + Math.mod(j, 3) * ((parent.width - 32px) / 3);
                y: 310px + Math.floor(j / 3) * 76px;
                width: (parent.width - 32px) / 3 - 12px;
                height: 70px;
                border-radius: 12px;
                background: net-key-ta.pressed ? #E4E8ED : #FFFFFF;
                border-width: 2px;
                border-color: #C9CFD7;
                opacity: root.net-dhcp ? 0.45 : 1.0;
                Text { text: k; font-size: 30px; font-weight: 700; color: #1A1E24; }
                net-key-ta := TouchArea { enabled: !root.net-dhcp; clicked => { root.net-key(k); } }
            }

            Rectangle {
                x: 8px;
                y: 614px;
                width: 160px;
                height: 50px;
                border-radius: 12px;
                background: net-clear-ta.pressed ? #E4E8ED : #EDF0F3;
                Text { text: "C"; font-size: 26px; font-weight: 700; color: #1A1E24; }
                net-clear-ta := TouchArea { clicked => { root.net-key("C"); } }
            }
            Rectangle {
                x: 188px;
                y: 614px;
                width: parent.width - 196px;
                height: 50px;
                border-radius: 12px;
                // Серая = данные неполные/неверные (живая валидация net-valid).
                background: root.net-valid
                    ? (net-apply-ta.pressed ? #2456C4 : #2F6FED)
                    : (net-apply-ta.pressed ? #9AA5B1 : #C3CAD3);
                Text {
                    text: root.net-dhcp ? "ПРИМЕНИТЬ DHCP" : "ПРИМЕНИТЬ";
                    font-size: 24px;
                    font-weight: 700;
                    color: #FFFFFF;
                }
                net-apply-ta := TouchArea { enabled: root.net-valid; clicked => { root.net-apply(); } }
            }
            // Модальное окно результата: затемнение, сообщение, ОК.
            if root.net-popup-open : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                background: rgba(10, 14, 20, 0.45);
                popup-net-ta := TouchArea { }
                Rectangle {
                    x: (parent.width - 560px) / 2;
                    y: (parent.height - 260px) / 2;
                    width: 560px;
                    height: 260px;
                    border-radius: 18px;
                    background: #FFFFFF;
                    Text {
                        x: 32px;
                        y: 28px;
                        width: parent.width - 64px;
                        text: root.net-popup-text;
                        font-size: 22px;
                        font-weight: 700;
                        color: root.net-popup-ok ? #1E7A3C : #C0392B;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        x: (parent.width - 220px) / 2;
                        y: parent.height - 88px;
                        width: 220px;
                        height: 60px;
                        border-radius: 14px;
                        background: net-popup-ta.pressed ? #1E4D3A : #2E7D57;
                        Text { text: "ОК"; font-size: 26px; font-weight: 700; color: #FFFFFF; }
                        net-popup-ta := TouchArea { clicked => { root.net-popup-close(); } }
                    }
                }
            }
        }

        // ---------- Экран 9: оборудование (подменю меню настроек) ----------
        // Диагностика/протяжка/тест-печать спрятаны сюда, чтобы не занимать
        // главное меню. Доступны персоналу, как и раньше.
        if root.screen == 9 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[MenuRow]> rows: [
                { label: "Диагностика", id: "diag", admin: false },
                { label: "Принтер", id: "printerdiag", admin: false },
                { label: "Протяжка ленты", id: "feed", admin: false },
                { label: "Тестовая печать", id: "testprint", admin: false },
            ];
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: menu-eq-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: r.label;
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                menu-eq-ta := TouchArea {
                    clicked => { root.menu-tap(r.id); }
                }
            }
        }

        // ---------- Экран 12: хаб «Настройки весов» ----------
        if root.screen == 12 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[MenuRow]> rows: [
                { label: "Товары и экран", id: "goods", admin: true },
                { label: "Торговые правила", id: "trade", admin: true },
                { label: "Обслуживание", id: "service", admin: false },
            ];
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: hub-ta.pressed ? #E4E8ED : #FFFFFF;
                opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: r.label + (r.admin && root.role != 1 ? " · только администратор" : "");
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                hub-ta := TouchArea {
                    clicked => {
                        (root.role == 1 || !r.admin) ? root.menu-tap(r.id) : {};
                    }
                }
            }
        }

        // ---------- Экран 13: товары и экран ----------
        if root.screen == 13 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[MenuRow]> rows: [
                { label: "Компоновка разделов", id: "layout", admin: true },
                { label: "Колонок на экране", id: "cols", admin: true },
                { label: "Порядок отделов", id: "sortalpha", admin: true },
                { label: "Возврат на главный экран", id: "idletimeout", admin: true },
                { label: "Экспорт конфигурации", id: "export", admin: true },
                { label: "Импорт конфигурации", id: "import", admin: true },
            ];
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: goods-ta.pressed ? #E4E8ED : #FFFFFF;
                opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
                Text {
                    x: 24px;
                    width: parent.width - 260px;
                    height: parent.height;
                    text: r.label + (r.admin && root.role != 1 ? " · только администратор" : "");
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Значение справа для переключаемых пунктов.
                if r.id == "cols" : Text {
                    x: parent.width - 230px;
                    width: 190px;
                    height: parent.height;
                    text: root.goods-cols;
                    font-size: 26px;
                    font-weight: 700;
                    color: #4A5460;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                if r.id == "sortalpha" : Text {
                    x: parent.width - 230px;
                    width: 190px;
                    height: parent.height;
                    text: root.goods-sort;
                    font-size: 26px;
                    font-weight: 700;
                    color: #4A5460;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                if r.id == "idletimeout" : Text {
                    x: parent.width - 230px;
                    width: 190px;
                    height: parent.height;
                    text: root.goods-idle;
                    font-size: 26px;
                    font-weight: 700;
                    color: #4A5460;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                goods-ta := TouchArea {
                    clicked => {
                        (root.role == 1 || !r.admin) ? root.menu-tap(r.id) : {};
                    }
                }
            }
        }

        // ---------- Экран 14: торговые правила ----------
        if root.screen == 14 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[MenuRow]> rows: [
                { label: "Округление цены", id: "rounding", admin: true },
                { label: "Минимальный вес печати", id: "minweight", admin: true },
            ];
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: trade-ta.pressed ? #E4E8ED : #FFFFFF;
                opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
                Text {
                    x: 24px;
                    width: parent.width - 260px;
                    height: parent.height;
                    text: r.label + (r.admin && root.role != 1 ? " · только администратор" : "");
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if r.id == "rounding" : Text {
                    x: parent.width - 230px;
                    width: 190px;
                    height: parent.height;
                    text: root.trade-rounding;
                    font-size: 26px;
                    font-weight: 700;
                    color: #4A5460;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                if r.id == "minweight" : Text {
                    x: parent.width - 230px;
                    width: 190px;
                    height: parent.height;
                    text: root.trade-minw;
                    font-size: 26px;
                    font-weight: 700;
                    color: #4A5460;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                trade-ta := TouchArea {
                    clicked => {
                        (root.role == 1 || !r.admin) ? root.menu-tap(r.id) : {};
                    }
                }
            }
        }

        // ---------- Экран 15: обслуживание ----------
        if root.screen == 15 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            property <[MenuRow]> rows: [
                { label: "Сменить пароль", id: "changepin", admin: false },
                { label: "Отчёты", id: "reports", admin: false },
            ];
            for r[i] in rows : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: svc-ta.pressed ? #E4E8ED : #FFFFFF;
                opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: r.label + (r.admin && root.role != 1 ? " · только администратор" : "");
                    font-size: 26px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                svc-ta := TouchArea {
                    clicked => {
                        (root.role == 1 || !r.admin) ? root.menu-tap(r.id) : {};
                    }
                }
            }
        }

        // ---------- Экран 16: импорт конфигурации ----------
        if root.screen == 16 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            if root.imp-files.length == 0 : Text {
                x: 16px;
                y: 24px;
                width: parent.width - 32px;
                height: 60px;
                text: "В каталоге обмена нет файлов конфигурации (.toml)";
                font-size: 24px;
                color: #4A5460;
                horizontal-alignment: center;
            }
            for name[i] in root.imp-files : Rectangle {
                x: 8px;
                y: 12px + i * 82px;
                width: parent.width - 16px;
                height: 74px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: imp-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    x: 24px;
                    width: parent.width - 48px;
                    height: parent.height;
                    text: name;
                    font-size: 24px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                imp-ta := TouchArea {
                    clicked => { root.import-tap(name); }
                }
            }

        }

        // ---------- Экран 17: отчёты ----------
        if root.screen == 17 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            // Фильтры: период и тип событий — циклы, отчёт пересобирается.
            Rectangle {
                x: 8px; y: 8px;
                width: (parent.width - 24px) / 2;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: rep-p-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: "Период: " + root.report-period;
                    font-size: 22px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                rep-p-ta := TouchArea { clicked => { root.menu-tap("report-period"); } }
            }
            Rectangle {
                x: 16px + (parent.width - 24px) / 2;
                y: 8px;
                width: (parent.width - 24px) / 2;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: rep-k-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: root.report-kind;
                    font-size: 22px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                rep-k-ta := TouchArea { clicked => { root.menu-tap("report-kind"); } }
            }

            Text {
                x: 24px;
                y: 76px;
                width: parent.width - 48px;
                height: parent.height - 92px;
                text: root.report-text;
                font-size: 19px;
                font-family: "DejaVu Sans Mono";
                color: #1A1E24;
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }

        // ---------- Экран 18: принтер · диагностика ----------
        if root.screen == 18 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            Rectangle {
                x: 8px; y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: prn-r-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: "Обновить";
                    font-size: 22px;
                    font-weight: 700;
                    color: #1A1E24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-r-ta := TouchArea { clicked => { root.menu-tap("prn-refresh"); } }
            }
            Rectangle {
                x: 16px + (parent.width - 32px) / 3;
                y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: prn-c-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    width: parent.width - 16px;
                    x: 8px;
                    height: parent.height;
                    text: "Калибровка";
                    font-size: 22px;
                    font-weight: 700;
                    color: #1A1E24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-c-ta := TouchArea { clicked => { root.menu-tap("prn-calib"); } }
            }
            Rectangle {
                x: 24px + 2 * (parent.width - 32px) / 3;
                y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: prn-x-ta.pressed ? #E4E8ED : #FFFFFF;
                Text {
                    width: parent.width - 16px;
                    x: 8px;
                    height: parent.height;
                    text: "Сброс аварии";
                    font-size: 22px;
                    font-weight: 700;
                    color: #1A1E24;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-x-ta := TouchArea { clicked => { root.menu-tap("prn-reset"); } }
            }

            Text {
                x: 24px;
                y: 76px;
                width: parent.width - 48px;
                height: parent.height - 92px;
                text: root.prn-diag-text;
                font-size: 19px;
                font-family: "DejaVu Sans Mono";
                color: #1A1E24;
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }

        // ---------- Экран 4: редактор отделов ----------
        if root.screen == 4 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;

            for r[i] in root.admin-rows : Rectangle {
                x: 8px;
                y: 12px + i * 72px;
                width: parent.width - 16px;
                height: 64px;
                border-radius: 12px;
                border-width: 2px;
                border-color: #C9CFD7;
                background: #FFFFFF;
                Text {
                    x: 16px;
                    width: 220px;
                    height: parent.height;
                    text: r.name;
                    font-size: 24px;
                    font-weight: 700;
                    color: #1A1E24;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Цвет плитки: цикл Авто → пресеты палитры, тап — следующий.
                // Кнопка стоит сразу после имени, вдали от стрелок порядка.
                Rectangle {
                    x: 250px;
                    y: 8px;
                    width: 176px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-col-ta.pressed ? #E4E8ED : #EDF0F3;
                    Rectangle {
                        x: 10px;
                        width: 28px;
                        height: 28px;
                        y: (parent.height - 28px) / 2;
                        border-radius: 14px;
                        border-width: 2px;
                        border-color: #C9CFD7;
                        background: r.color;
                    }
                    Text {
                        x: 44px;
                        width: parent.width - 52px;
                        height: parent.height;
                        text: r.color-label;
                        font-size: 15px;
                        font-weight: 700;
                        color: #4A5460;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    admin-col-ta := TouchArea { clicked => { root.admin-color(r.name); } }
                }
                if !r.first : Rectangle {
                    x: parent.width - 232px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-up-ta.pressed ? #E4E8ED : #EDF0F3;
                    Text { text: "↑"; font-size: 26px; font-weight: 700; color: #4A5460; }
                    admin-up-ta := TouchArea { clicked => { root.admin-up(r.name); } }
                }
                if !r.last : Rectangle {
                    x: parent.width - 156px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-down-ta.pressed ? #E4E8ED : #EDF0F3;
                    Text { text: "↓"; font-size: 26px; font-weight: 700; color: #4A5460; }
                    admin-down-ta := TouchArea { clicked => { root.admin-down(r.name); } }
                }
                Rectangle {
                    x: parent.width - 80px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-del-ta.pressed ? #F2B8B5 : #F6DEDD;
                    Text { text: "✕"; font-size: 26px; font-weight: 700; color: #7A2E2E; }
                    admin-del-ta := TouchArea { clicked => { root.admin-del(r.name); } }
                }
            }
        }
            // Подтверждение / результат импорта.
            if root.imp-popup-open : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                background: #00000040;
                Rectangle {
                    x: (parent.width - 640px) / 2;
                    y: (parent.height - 320px) / 2;
                    width: 640px;
                    height: 320px;
                    border-radius: 16px;
                    background: #FFFFFF;
                    Text {
                        x: 24px; y: 24px;
                        width: parent.width - 48px;
                        height: 200px;
                        text: root.imp-popup-text;
                        font-size: 24px;
                        color: #1A1E24;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: word-wrap;
                    }
                    if root.imp-confirm : Rectangle {
                        x: 24px;
                        y: parent.height - 80px;
                        width: 280px;
                        height: 56px;
                        border-radius: 12px;
                        background: imp-no-ta.pressed ? #E4E8ED : #EDF0F3;
                        Text {
                            text: "ОТМЕНА";
                            font-size: 24px;
                            font-weight: 700;
                            color: #1A1E24;
                        }
                        imp-no-ta := TouchArea {
                            clicked => { root.imp-popup-close(); }
                        }
                    }
                    Rectangle {
                        x: parent.width - 304px;
                        y: parent.height - 80px;
                        width: 280px;
                        height: 56px;
                        border-radius: 12px;
                        background: imp-yes-ta.pressed ? #1E4D3A : #2E7D57;
                        Text {
                            text: root.imp-confirm ? "ПРИМЕНИТЬ" : "OK";
                            font-size: 24px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        imp-yes-ta := TouchArea {
                            clicked => {
                                root.imp-confirm ? root.import-apply() : root.imp-popup-close();
                            }
                        }
                    }
                }
            }

    }
}
