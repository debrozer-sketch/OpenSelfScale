        }
        Rectangle {
            x: 152px; y: 150px;
            width: 720px; height: 468px;
            border-radius: 24px;
            border-width: 2px;
            border-color: Theme.border;
            background: Theme.surface;
            popup-panel-ta := TouchArea { }
            Rectangle {
                x: 24px;
                y: 24px;
                width: 280px;
                height: 280px;
                border-radius: 16px;
                clip: true;
                background: Theme.chip;
                if root.popup-plu.has-img : Image {
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                    source: root.popup-plu.img;
                }
            }
            if root.card-show-name : Text {
