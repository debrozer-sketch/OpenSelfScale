                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: lbl-cal-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    text: "Проверка\nроликов";
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    wrap: no-wrap;
                }
                lbl-cal-ta := TouchArea { clicked => { root.labels-calibrate(); } }
            }
            Rectangle {
                x: 16px + third;
                y: 12px;
                width: third;
                height: 64px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: lbl-probe-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    text: "Линейка";
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                lbl-probe-ta := TouchArea { clicked => { root.labels-probe(); } }
            }
            Rectangle {
                x: 24px + 2 * third;
                y: 12px;
                width: third;
                height: 64px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: lbl-imp-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    text: "Импорт JSON";
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                lbl-imp-ta := TouchArea { clicked => { root.labels-import-tap(-1); } }
            }
            Text {
                x: 16px;
                y: 84px;
                width: parent.width - 32px;
                height: 40px;
                text: root.labels-status;
                font-size: Theme.font-body;
                color: Theme.ink-soft;
                vertical-alignment: center;
                overflow: elide;
            }
            Flickable {
                x: 0;
                y: 124px;
                width: parent.width;
                height: parent.height - 124px;
                viewport-width: parent.width;
                viewport-height: 16px + (root.labels-files.length > 0 ? 42px + root.labels-files.length * 72px : 0px) + (root.labels-rows.length > 0 ? 42px + root.labels-rows.length * 72px : 0px);
                if root.labels-files.length > 0 : Text {
                    x: 16px;
                    y: 6px;
                    width: parent.width - 32px;
                    height: 34px;
                    text: "Файлы для импорта";
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    color: Theme.ink-soft;
                    vertical-alignment: center;
                }
                for name[i] in root.labels-files : Rectangle {
                    x: 8px;
                    y: 44px + i * 72px;
                    width: parent.width - 16px;
                    height: 62px;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: Theme.border;
                    background: lbl-f-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        x: 24px;
                        width: parent.width - 48px;
                        height: parent.height;
                        text: name;
                        font-size: Theme.font-body;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    lbl-f-ta := TouchArea { clicked => { root.labels-import-tap(i); } }
                }
                if root.labels-rows.length > 0 : Text {
                    x: 16px;
                    y: root.labels-files.length > 0 ? 44px + root.labels-files.length * 72px + 8px : 6px;
                    width: parent.width - 32px;
                    height: 34px;
                    text: "Загруженные раскладки · нажмите, чтобы удалить";
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    color: Theme.ink-soft;
                    vertical-alignment: center;
                }
                for row[i] in root.labels-rows : Rectangle {
                    x: 8px;
                    y: (root.labels-files.length > 0 ? 44px + root.labels-files.length * 72px + 46px : 44px) + i * 72px;
                    width: parent.width - 16px;
                    height: 62px;
                    border-radius: 12px;
                    border-width: 2px;
                    border-color: Theme.border;
                    background: lbl-r-ta.pressed ? Theme.success-soft : Theme.surface;
                    Text {
                        x: 24px;
                        width: parent.width - 96px;
                        height: parent.height;
                        text: row;
                        font-size: Theme.font-body;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    lbl-r-ta := TouchArea { clicked => { root.labels-tap(i); } }
                    Rectangle {
                        x: parent.width - 64px;
                        y: 9px;
                        width: 44px;
                        height: 44px;
                        border-radius: 10px;
                        background: lbl-del-ta.pressed ? Theme.danger-pressed : Theme.danger-soft;
                        Text { text: "✕"; font-size: Theme.font-body; font-weight: 700; color: Theme.danger-ink; }
                        lbl-del-ta := TouchArea { clicked => { root.labels-delete-tap(i); } }
                    }}
                if root.labels-rows.length == 0 && root.labels-files.length == 0 : Text {
                    x: 16px;
                    y: 20px;
                    width: parent.width - 32px;
                    height: 80px;
                    text: "Раскладок нет.\nСоберите раскладку в конструкторе и положите label-*.json в каталог обмена.";
                    font-size: Theme.font-body;
                    color: Theme.ink-soft;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        if root.screen == 17 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            Rectangle {
                x: 8px; y: 8px;
                width: (parent.width - 24px) / 2;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: rep-p-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: "Период: " + root.report-period;
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                rep-p-ta := TouchArea { clicked => { root.menu-tap("report-period"); } }
            }
            Rectangle {
                x: 16px + (parent.width - 24px) / 2;
                y: 8px;
                width: (parent.width - 24px) / 2;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: rep-k-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: root.report-kind;
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                rep-k-ta := TouchArea { clicked => { root.menu-tap("report-kind"); } }
            }
            Text {
                x: 24px;
                y: 76px;
                width: parent.width - 48px;
                height: parent.height - 92px;
                text: root.report-text;
                font-size: Theme.font-sm;
                font-family: "DejaVu Sans Mono";
                color: Theme.ink;
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }
        if root.screen == 18 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            Rectangle {
                x: 8px; y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: prn-r-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    width: parent.width - 32px;
                    x: 16px;
                    height: parent.height;
                    text: "Обновить";
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-r-ta := TouchArea { clicked => { root.menu-tap("prn-refresh"); } }
            }
            Rectangle {
                x: 16px + (parent.width - 32px) / 3;
                y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: prn-c-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    width: parent.width - 16px;
                    x: 8px;
                    height: parent.height;
                    text: "Калибровка";
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-c-ta := TouchArea { clicked => { root.menu-tap("prn-calib"); } }
            }
            Rectangle {
                x: 24px + 2 * (parent.width - 32px) / 3;
                y: 8px;
                width: (parent.width - 32px) / 3;
                height: 56px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: prn-x-ta.pressed ? Theme.pressed : Theme.surface;
                Text {
                    width: parent.width - 16px;
                    x: 8px;
                    height: parent.height;
                    text: "Сброс аварии";
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                prn-x-ta := TouchArea { clicked => { root.menu-tap("prn-reset"); } }
            }
            Text {
                x: 24px;
                y: 76px;
                width: parent.width - 48px;
                height: parent.height - 92px;
                text: root.prn-diag-text;
                font-size: Theme.font-sm;
                font-family: "DejaVu Sans Mono";
                color: Theme.ink;
                vertical-alignment: top;
                wrap: word-wrap;
            }
        }
        if root.screen == 4 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            Flickable {
                width: parent.width;
                height: parent.height;
                viewport-height: 12px + root.admin-rows.length * 72px;
                for r[i] in root.admin-rows : Rectangle {
                x: 8px;
                y: 12px + i * 72px;
                width: parent.width - 16px;
                height: 64px;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.border;
                background: Theme.surface;
                Text {
                    x: 16px;
                    width: 220px;
                    height: parent.height;
                    text: r.name;
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    x: 250px;
                    y: 8px;
                    width: 176px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-col-ta.pressed ? Theme.pressed : Theme.chip;
                    Rectangle {
                        x: 10px;
                        width: 28px;
                        height: 28px;
                        y: (parent.height - 28px) / 2;
                        border-radius: 14px;
                        border-width: 2px;
                        border-color: Theme.border;
                        background: r.color;
                    }
                    Text {
                        x: 44px;
                        width: parent.width - 52px;
                        height: parent.height;
                        text: r.color-label;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        color: Theme.ink-soft;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    admin-col-ta := TouchArea { clicked => { root.admin-color(r.name); } }
                }
                if !r.first : Rectangle {
                    x: parent.width - 232px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-up-ta.pressed ? Theme.pressed : Theme.chip;
                    Text { text: "↑"; font-size: Theme.font-h3; font-weight: 700; color: Theme.ink-soft; }
                    admin-up-ta := TouchArea { clicked => { root.admin-up(r.name); } }
                }
                if !r.last : Rectangle {
                    x: parent.width - 156px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-down-ta.pressed ? Theme.pressed : Theme.chip;
                    Text { text: "↓"; font-size: Theme.font-h3; font-weight: 700; color: Theme.ink-soft; }
                    admin-down-ta := TouchArea { clicked => { root.admin-down(r.name); } }
                }
                Rectangle {
                    x: parent.width - 80px;
                    y: 8px;
                    width: 64px;
                    height: 48px;
                    border-radius: 10px;
                    background: admin-del-ta.pressed ? Theme.danger-pressed : Theme.danger-soft;
                    Text { text: "✕"; font-size: Theme.font-h3; font-weight: 700; color: Theme.danger-ink; }
                    admin-del-ta := TouchArea { clicked => { root.admin-del(r.name); } }
                }
                }
            }
        }
            if root.imp-popup-open || root.labels-popup-open : lbl-pop := Rectangle {
                property <bool> imp-mode: root.imp-popup-open;
                property <bool> confirm: imp-mode ? root.imp-confirm : root.labels-confirm;
                property <string> ptext: imp-mode ? root.imp-popup-text : root.labels-popup-text;
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                background: Theme.overlay;
                Rectangle {
                    x: (parent.width - 640px) / 2;
                    y: (parent.height - 320px) / 2;
                    width: 640px;
                    height: 320px;
                    border-radius: 16px;
                    background: Theme.surface;
                    Text {
                        x: 24px; y: 24px;
                        width: parent.width - 48px;
                        height: 200px;
                        text: ptext;
                        font-size: Theme.font-lg;
                        color: Theme.ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: word-wrap;
                    }
                    if confirm : Rectangle {
                        x: 24px;
                        y: parent.height - 80px;
                        width: 280px;
                        height: 56px;
                        border-radius: 12px;
                        background: imp-no-ta.pressed ? Theme.pressed : Theme.chip;
                        Text {
                            text: "ОТМЕНА";
                            font-size: Theme.font-lg;
                            font-weight: 700;
                            color: Theme.ink;
                        }
                        imp-no-ta := TouchArea {
                            clicked => {
                                imp-mode ? root.imp-popup-close() : root.labels-popup-close();
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 304px;
                        y: parent.height - 80px;
                        width: 280px;
                        height: 56px;
                        border-radius: 12px;
                        background: imp-yes-ta.pressed ? Theme.success-dark : Theme.success;
                        Text {
                            text: imp-mode
                                ? (root.imp-confirm ? "ПРИМЕНИТЬ" : "OK")
                                : (root.labels-confirm ? "УДАЛИТЬ" : "OK");
                            font-size: Theme.font-lg;
                            font-weight: 700;
                            color: Theme.surface;
                        }
                        imp-yes-ta := TouchArea {
                            clicked => {
                                imp-mode
                                    ? (root.imp-confirm ? root.import-apply() : root.imp-popup-close())
                                    : (root.labels-confirm ? root.labels-confirm-apply() : root.labels-popup-close());
                            }
                        }
                    }
                }
            }
            if root.labels-preview-open : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                background: Theme.overlay-strong;
                Rectangle {
                    x: (parent.width - root.labels-preview-scale * 58px) / 2;
                    y: (parent.height - root.labels-preview-scale * root.labels-preview-h * 1px - 72px) / 2;
                    width: root.labels-preview-scale * 58px;
                    height: root.labels-preview-scale * root.labels-preview-h * 1px;
                    background: Theme.surface;
                    border-width: 2px;
                    border-color: Theme.ink;
                    for r in root.labels-preview-rows : Rectangle {
                        x: r.x * root.labels-preview-scale * 1px;
                        y: r.y * root.labels-preview-scale * 1px;
                        width: r.w * root.labels-preview-scale * 1px;
                        height: r.h * root.labels-preview-scale * 1px;
                        Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.text;
                            font-size: Theme.font-md;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            visible: r.kind == 0;
                        }
                    }
                    for r in root.labels-preview-rows : Rectangle {
                        x: r.x * root.labels-preview-scale * 1px;
                        y: r.y * root.labels-preview-scale * 1px;
                        width: r.w * root.labels-preview-scale * 1px;
                        height: r.h * root.labels-preview-scale * 1px;
                        Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.text;
                            font-size: 13px;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            visible: r.kind == 2;
                        }
                    }
                    for r in root.labels-preview-rows : Rectangle {
                        x: r.x * root.labels-preview-scale * 1px;
                        y: r.y * root.labels-preview-scale * 1px;
                        width: r.w * root.labels-preview-scale * 1px;
                        height: r.h * root.labels-preview-scale * 1px;
                        Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.text;
                            font-size: Theme.font-h2;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            visible: r.kind == 3;
                        }
                    }
                    for r in root.labels-preview-rows : Rectangle {
                        x: r.x * root.labels-preview-scale * 1px;
                        y: r.y * root.labels-preview-scale * 1px;
                        width: r.w * root.labels-preview-scale * 1px;
                        height: r.h * root.labels-preview-scale * 1px;
                        Text {
                            x: 0;
                            width: parent.width;
                            height: parent.height;
                            text: r.text;
                            font-size: Theme.font-h3;
                            color: Theme.ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: no-wrap;
                            visible: r.kind == 4;
                        }
                    }
                    for r in root.labels-preview-rows : Rectangle {
                        x: r.x * root.labels-preview-scale * 1px;
                        y: r.y * root.labels-preview-scale * 1px;
                        width: r.w * root.labels-preview-scale * 1px;
                        height: r.h * root.labels-preview-scale * 1px;
                        visible: r.kind == 1;
                        background: Theme.ink;
                    }
                }
                if root.labels-preview-importable : Rectangle {
                    x: (parent.width - 600px) / 2;
                    y: parent.height - 96px;
                    width: 280px;
                    height: 64px;
                    border-radius: 12px;
                    background: lbl-imp-yes-ta.pressed ? Theme.success-dark : Theme.success;
                    Text {
                        text: "ИМПОРТИРОВАТЬ";
                        font-size: Theme.font-sm;
                        font-weight: 700;
                        color: Theme.surface;
                    }
                    lbl-imp-yes-ta := TouchArea { clicked => { root.labels-preview-import(); } }
                }
                Rectangle {
                    x: root.labels-preview-importable ? (parent.width - 600px) / 2 + 320px : (parent.width - 280px) / 2;
                    y: parent.height - 96px;
                    width: 280px;
                    height: 64px;
                    border-radius: 12px;
                    background: lbl-pv-ta.pressed ? Theme.success-dark : Theme.success;
                    Text {
                        text: root.labels-preview-importable ? "ОТМЕНА" : ("ЗАКРЫТЬ · " + root.labels-preview-name);
                        font-size: Theme.font-sm;
                        font-weight: 700;
                        color: Theme.surface;
                        overflow: elide;
                    }
                     lbl-pv-ta := TouchArea { clicked => { root.labels-preview-close(); } }
                }
            }
    }
}

