            if p.card-price != "" : Text {
                x: 790px;
                width: 190px;
                height: parent.height;
                text: p.card-price;
                font-size: Theme.font-md;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.success-bright;
            }
            res-ta := TouchArea {
                clicked => { root.plu-tapped(p.id); }
            }
        }
        if root.items.length == 0 && root.search-text == "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Начните вводить название товара";
            font-size: Theme.font-body;
            horizontal-alignment: center;
            color: Theme.ink-faint;
        }
        if root.items.length == 0 && root.search-text != "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Ничего не найдено";
            font-size: Theme.font-body;
            horizontal-alignment: center;
            color: Theme.ink-faint;
        }
        for k[i] in root.kb1 : KbKey {
            kx: 8px + i * 78px;
            y: 404px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb2 : KbKey {
            kx: 82px + i * 78px;
            y: 470px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb3 : KbKey {
            kx: 8px + i * 78px;
            y: 536px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 712px;
            y: 536px;
            kw: 170px;
            key: "ПРОБЕЛ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 890px;
            y: 536px;
            kw: 118px;
            key: "ЗАБОЙ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb4 : KbKey {
