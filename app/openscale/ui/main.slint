                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.ink;
            }
            Text {
                x: 328px; y: root.card-show-name ? 100px : 24px;
                width: 368px; height: 32px;
                text: "Цена: " + root.popup-plu.price;
                font-size: Theme.font-body;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if root.popup-plu.card-price != "" : Text {
                x: 328px; y: root.card-show-name ? 136px : 60px;
                width: 368px; height: 32px;
                text: "По скидочной карте: " + root.popup-plu.card-price;
                font-size: Theme.font-md;
                font-weight: 700;
                vertical-alignment: center;
                color: Theme.success-bright;
            }
            if !root.popup-empty : Text {
                x: 24px; y: 312px;
                width: 300px; height: 72px;
                text: root.popup-weight;
                font-size: Theme.font-h1;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if !root.popup-empty : Text {
                x: 328px; y: 316px;
