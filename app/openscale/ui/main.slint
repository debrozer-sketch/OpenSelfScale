            kx: 712px;
            y: 448px;
            kw: 170px;
            key: "ПРОБЕЛ";
            key-tapped(k) => { root.img-key(k); }
        }
        KbKey {
            kx: 890px;
            y: 448px;
            kw: 118px;
            key: "←";
            key-tapped(k) => { root.img-key(k); }
        }
        Rectangle {
            x: 8px;
            y: 524px;
            width: (parent.width - 24px) / 2;
            height: 54px;
            border-radius: Theme.r-button;
            background: img-save-ta.pressed ? Theme.accent-pressed : Theme.accent;
            Text {
                text: "СОХРАНИТЬ";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.surface;
            }
            img-save-ta := TouchArea { clicked => { root.img-save(); } }
        }
        Rectangle {
            x: 16px + (parent.width - 24px) / 2;
            y: 524px;
            width: (parent.width - 24px) / 2;
            height: 54px;
            border-radius: Theme.r-button;
            background: root.img-busy ? Theme.accent-disabled : (img-fetch-ta.pressed ? Theme.pressed : Theme.surface);
            Text {
                text: root.img-busy ? "СКАЧИВАЮ..." : "СКАЧАТЬ СЕЙЧАС";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.ink;
            }
            img-fetch-ta := TouchArea { enabled: !root.img-busy; clicked => { root.img-fetch(); } }
        }
        Text {
            x: 16px;
            y: 588px;
            width: parent.width - 32px;
            height: 40px;
            text: root.img-status;
            font-size: Theme.font-sm;
            color: root.img-ok ? Theme.success : Theme.danger;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.db-unavailable : Rectangle {
        // Блокирующий оверлей: торговля и меню недоступны до восстановления БД.
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: Theme.bg;
        TouchArea { }
        Rectangle {
            x: (parent.width - 720px) / 2;
            y: (parent.height - 240px) / 2;
            width: 720px;
            height: 240px;
            border-radius: Theme.r-button;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.ink;
            VerticalLayout {
                padding: 32px;
                spacing: 16px;
                alignment: center;
                Text {
                    text: "БАЗА ДАННЫХ НЕДОСТУПНА";
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Торговля приостановлена. Обратитесь к администратору.";
                    font-size: Theme.font-md;
                    color: Theme.ink-soft;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.db-error-text;
                    font-size: Theme.font-sm;
                    color: Theme.ink-faint;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
    }
}

