        Rectangle {
            x: 8px; y: 8px;
            width: parent.width - 16px;
            height: 64px;
            border-radius: 16px;
            border-width: 2px;
            border-color: Theme.border;
            background: Theme.surface;
            Text {
                x: 16px;
                width: parent.width - 440px;
