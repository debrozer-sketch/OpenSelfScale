                text: "Итого: " + root.popup-sum;
                font-size: Theme.font-h3;
                font-weight: 700;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if !root.popup-empty && root.popup-plu.card-price != "" : Text {
                x: 328px; y: 352px;
                width: 368px; height: 32px;
                text: "Со скидочной картой: " + root.popup-card-sum;
                font-size: Theme.font-sm;
                font-weight: 700;
                vertical-alignment: center;
                color: Theme.success-bright;
            }
            if root.popup-empty : Text {
                x: 24px; y: 320px;
