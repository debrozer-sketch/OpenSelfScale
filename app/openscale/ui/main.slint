                border-color: row.state == 2 ? Theme.success
                    : (row.state == 1 && root.setup-mode == 0 ? Theme.warning
                    : (row.state == 1 ? Theme.success : Theme.border));
                background: row.state == 2 ? Theme.success-soft
                    : (row.state == 1 && root.setup-mode == 0 ? Theme.warning-soft
