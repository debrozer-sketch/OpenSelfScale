                text: "ДАЛЕЕ →";
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: Theme.ink-soft;
            }
            next2-ta := TouchArea {
                clicked => { root.more(); }
            }
        }
    }
    if screen == 0 : Rectangle {
