            y: 602px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
    }
    if root.popup-open : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: transparent;
        popup-back-ta := TouchArea {
