            y: 56px + Math.floor((root.items.length + root.items-cell-offset) / root.items-cols) * 182px;
            width: root.items-col-w;
            height: 178px;
            border-radius: 12px;
            border-width: 2px;
            border-color: Theme.border;
            background: next2-ta.pressed ? Theme.pressed : Theme.surface;
