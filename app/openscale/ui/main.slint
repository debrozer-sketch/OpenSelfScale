
export struct DeptDef {
    id: string,
    name: string,
    bg: color,
    fg: color,
    bg-pressed: color,
    img: image,
    has-img: bool,
}
export struct PluTile {
    id: string,
    name: string,
    price: string,
    card-price: string,
    has-img: bool,
    img: image,
    hl-before: string,
    hl-match: string,
    hl-after: string,
}
export struct AdminRow {
    name: string,
    first: bool,
    last: bool,
    color-label: string,
    color: color,
}
export struct MenuRow {
    label: string,
    id: string,
    admin: bool,
    sub: string,
    value: string,
}
export struct NetworkField {
    label: string,
    value: string,
}
export struct SetupRow {
    label: string,
    state: int,
}
export struct LabelPreviewRow {
    x: float,
    y: float,
    w: float,
    h: float,
    text: string,
    kind: int,
}
export struct ReportOp {
    rowid: int,
    text: string,
    can-reprint: bool,
}
export struct MaintRow {
    label: string,
    value: string,
    // 0 — норма, 1 — внимание, 2 — проблема
    state: int,
}
component DeptTile inherits Rectangle {
    in property <int> idx;
    in property <int> cols: 1;
    in property <length> col-w;
    in property <length> tile-h;
    in property <length> font;
    in property <DeptDef> d;
    in property <bool> active: true;
    in property <bool> cell: false;
    callback tapped(string);
    callback dragging(length);
    callback drag-end(length);
    width: root.col-w;
    x: 8px + Math.mod(self.idx, self.cols) * (root.col-w + 8px);
    y: 8px + Math.floor(self.idx / self.cols) * (root.tile-h + 8px);
    height: root.tile-h;
    border-radius: Theme.r-card;
    border-width: root.cell ? 2px : 1px;
    border-color: root.cell ? Theme.ink-faint : Theme.border;
    background: root.cell
        ? (ta.pressed && Math.abs(root.moved-px) < 10px ? Theme.pressed : Theme.surface)
        : (ta.pressed && Math.abs(root.moved-px) < 10px ? d.bg-pressed : d.bg);
    animate background { duration: 80ms; }
    if !root.cell && d.has-img : Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 110px - 16px;
        border-radius: Theme.r-panel;
        clip: true;
        Image {
            width: 100%;
            height: 100%;
            image-fit: cover;
            source: d.img;
        }
    }
    if !root.cell && !d.has-img : Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 110px - 16px;
        border-radius: Theme.r-panel;
        background: Theme.scrim;
    }
    Text {
        property <length> ty: root.cell ? 0px : parent.height - 110px;
        x: 8px;
        y: ty;
        width: parent.width - 16px;
        height: root.cell ? parent.height : 90px;
        text: d.name;
        font-size: root.cell ? 28px : root.font;
        font-weight: 700;
        color: root.cell ? Theme.ink : d.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> down-x;
    property <length> moved-px;
    ta := TouchArea {
        enabled: root.active;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.down-x = self.absolute-position.x + self.mouse-x;
                root.moved-px = 0px;
            } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                root.drag-end(self.absolute-position.x + self.mouse-x - root.down-x);
            }
        }
        moved => {
            root.moved-px = self.absolute-position.x + self.mouse-x - root.down-x;
            root.dragging(root.moved-px);
        }
        clicked => {
            if Math.abs(root.moved-px) < 16px {
                root.tapped(root.d.id);
            }
        }
    }
}
component PluCard inherits Rectangle {
    in property <int> idx;
    in property <int> cell-offset: 0;
    in property <int> cols: 9;
    in property <length> col-w: 108px;
    in property <PluTile> p;
    in property <bool> active: true;
    in property <bool> card-show-name: true;
    callback tapped;
    callback dragging(length);
    callback drag-end(length);
    property <length> down-x;
    property <length> moved-px;
    property <bool> hot: ta.pressed && Math.abs(root.moved-px) < 10px;
    width: root.col-w;
    height: 178px;
    x: 8px + Math.mod(self.idx + self.cell-offset, self.cols) * (root.col-w + 8px);
    y: 56px + Math.floor((self.idx + self.cell-offset) / self.cols) * 182px;
    border-radius: Theme.r-button;
    background: !root.active ? Theme.chip : root.hot ? Theme.pressed : Theme.surface;
    animate background { duration: 80ms; }
    Rectangle {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: root.card-show-name ? 76px : 124px;
        border-radius: Theme.r-inner;
        clip: true;
        background: Theme.chip;
        if root.p.has-img : Image {
            width: 100%;
            height: 100%;
            image-fit: contain;
            source: root.p.img;
        }
    }
    if root.card-show-name : Text {
        x: 4px;
        y: 82px;
        width: parent.width - 8px;
        height: 49px;
        text: root.p.name;
        font-size: 12px;
        font-weight: 500;
        wrap: word-wrap;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.active ? Theme.ink-mute : Theme.ink;
    }
    if root.p.card-price == "" : Text {
        x: 4px;
        y: 134px;
        width: parent.width - 8px;
        height: 40px;
        text: root.p.price;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: !root.active ? Theme.ink-mute : Theme.ink;
    }
    if root.p.card-price != "" : Text {
        x: 4px;
        y: 132px;
        width: parent.width - 8px;
        height: 14px;
        text: root.p.price;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.ink-mute;
    }
    if root.p.card-price != "" : Text {
        x: 4px;
        y: 146px;
        width: parent.width - 8px;
        height: 26px;
        text: root.p.card-price;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: Theme.success-text;
    }
    ta := TouchArea {
        enabled: root.active;
        pointer-event(ev) => {
            if ev.kind == PointerEventKind.down {
                root.down-x = self.absolute-position.x + self.mouse-x;
                root.moved-px = 0px;
            } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                root.drag-end(self.absolute-position.x + self.mouse-x - root.down-x);
            }
        }
        moved => {
            root.moved-px = self.absolute-position.x + self.mouse-x - root.down-x;
            root.dragging(root.moved-px);
        }
        clicked => {
            if Math.abs(root.moved-px) < 16px {
                root.tapped();
            }
        }
    }
}
component KbKey inherits Rectangle {
    in property <string> key;
    in property <length> kw: 72px;
    in property <length> kx;
    callback key-tapped(string);
    x: root.kx;
    width: root.kw;
    height: 58px;
    border-radius: Theme.r-button;
    border-width: 1px;
    border-color: Theme.border;
    background: k-ta.pressed ? Theme.pressed : Theme.surface;
    Text {
        text: root.key;
        font-size: Theme.font-body;
        color: Theme.ink;
    }
    k-ta := TouchArea {
        clicked => { root.key-tapped(root.key); }
    }
    Timer {
        interval: 250ms;
        running: k-ta.pressed && (root.key == "←" || root.key == "ЗАБОЙ");
        triggered => { root.key-tapped("ЗАБОЙ"); }
    }
}
global Theme {
    // Поверхности и слои (светлый «планшетный» стиль, ревизия 2026-10-29)
    in property <color> bg: #F4F4F5;           // фон окна
    in property <color> surface: #FFFFFF;      // карточки, попапы
    in property <color> chip: #EBEBEB;         // клавиши, чипы, вторичные кнопки
    in property <color> pressed: #E0E0E0;      // нажатое состояние surface
    in property <color> pressed-deep: #D4D4D4; // нажатое состояние surface-белого
    // Текст
    in property <color> ink: #111318;
    in property <color> ink-soft: #4B5563;
    in property <color> ink-faint: #9CA3AF;    // только декор и отключённое (контраст 2.5:1)
    in property <color> ink-mute: #6B7280;     // подписи и вторичный текст (4.8:1)
    in property <color> success-text: #15803D; // зелёный текст на белом (5.0:1)
    in property <color> success-ink: #14532D;
    in property <color> disabled: #9CA3AB;     // недоступное
    // Границы (1px только у чипов, кнопок и полей; карточки — без рамок)
    in property <color> border: #E4E4E7;
    in property <color> border-soft: #ECECEE;
    // Акцент (синий, администрирование)
    in property <color> accent: #1B55E8;
    in property <color> accent-pressed: #1443BC;
    in property <color> accent-disabled: #9AA1AB;
    // Успех (зелёный)
    in property <color> success: #16A34A;
    in property <color> success-bright: #16A34A;
    in property <color> success-dark: #15803D;
    in property <color> success-soft: #EAF7EF;
    // Опасность (красный)
    in property <color> danger: #C62828;
    in property <color> danger-bright: #C62828;
    in property <color> danger-pressed: #F3C1BF;
    in property <color> danger-soft: #FDECEA;
    in property <color> danger-ink: #7A1C1C;
    // Предупреждение (янтарь)
    in property <color> warning: #9A5B00;
    in property <color> warning-strong: #B47700;
    in property <color> warning-deep: #9A5B00;
    in property <color> warning-soft: #FFF3D6;
    in property <color> warning-ink: #6B4400;
    // Затемнение под попапами
    in property <color> overlay: rgba(9, 9, 11, 0.5);
    in property <color> overlay-strong: rgba(9, 9, 11, 0.65);
    in property <color> scrim: rgba(255, 255, 255, 0.8);
    // Пастельные подложки иконок меню (по индексу строки)
    in property <[color]> pastel: [
        #E8F0FE, #E6F4EA, #FEF7E0, #FCE8E6, #F3E8FD,
        #E0F2F1, #FFF3E0, #E3F2FD, #F1F8E9,
    ];
    // Радиусы (концентрические: внутренний = внешний минус отступ)
    in property <length> r-panel: 20px;
    in property <length> r-card: 14px;
    in property <length> r-button: 12px;
    in property <length> r-inner: 8px;
    // Шрифт: IBM Plex Sans; при отсутствии шрифта в системе — fallback системный
    in property <string> family: "IBM Plex Sans";
    // Шрифтовая шкала (маппинг на t-* из proposal: display 92, title 30, headline 24, body 20, label 16)
    // display: 80px — не 92 из proposal: femtovg на GPU киоска не растеризует
    // глифы крупнее ~84px (проверено на стенде: 80 рисуется, 88 — пусто)
    in property <length> font-display: 80px;
    in property <length> font-h1: 30px;
    in property <length> font-h2: 30px;
    in property <length> font-h3: 24px;
    in property <length> font-lg: 24px;
    in property <length> font-body: 20px;
    in property <length> font-sm: 18px;
    in property <length> font-md: 16px;
    in property <length> font-xs: 16px;
}

component AppButton inherits Rectangle {
    in property <string> label;
    in property <int> kind: 0; // 0 chip, 1 accent, 2 success, 3 danger-soft
    in property <bool> enabled: true;
    in property <length> font-size: Theme.font-body;
    in property <color> text-color: Theme.ink;
    callback clicked();
    property <color> base:
        kind == 1 ? Theme.accent
        : kind == 2 ? Theme.success
        : kind == 3 ? Theme.danger-soft
        : Theme.chip;
    property <color> hit:
        kind == 1 ? Theme.accent-pressed
        : kind == 2 ? Theme.success-dark
        : kind == 3 ? Theme.danger-pressed
        : Theme.pressed;
    border-radius: Theme.r-button;
    background: !enabled ? Theme.border-soft : ta.pressed ? hit : base;
    animate background { duration: 80ms; }
    Text {
        text: root.label;
        font-size: root.font-size;
        font-weight: 700;
        color: !root.enabled ? Theme.ink-faint : root.text-color;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MenuPage inherits Rectangle {
    in property <[MenuRow]> rows;
    in property <int> role;
    in property <bool> ok: false;
    callback page-tap(string);
    Flickable {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: 12px + rows.length * 82px;
        for r[i] in root.rows : Rectangle {
            x: 8px;
            y: 12px + i * 82px;
            width: parent.width - 16px;
            height: 74px;
            border-radius: Theme.r-button;
            background: r.id == "" ? transparent : (mp-ta.pressed ? Theme.pressed : Theme.surface);
            animate background { duration: 80ms; }
            opacity: root.role == 1 || !r.admin ? 1.0 : 0.45;
            Text {
                x: 24px;
                y: r.sub == "" ? 0px : (parent.height - 50px) / 2;
                width: parent.width - (r.value == "" ? 110px : 330px);
                height: r.sub == "" ? parent.height : 28px;
                text: r.label + (r.id != "" && r.admin && root.role != 1 ? " · только администратор" : "");
                font-size: r.id == "" ? 18px : 24px;
                font-weight: 700;
                color: r.id == "" ? Theme.ink-mute : Theme.ink;
                vertical-alignment: center;
                overflow: elide;
            }
            if r.sub != "" : Text {
                x: 24px;
                y: (parent.height - 50px) / 2 + 28px;
                width: parent.width - (r.value == "" ? 110px : 330px);
                height: 22px;
                text: r.sub;
                font-size: 16px;
                color: Theme.ink-soft;
                vertical-alignment: center;
                overflow: elide;
            }
            if r.value != "" : Rectangle {
                x: parent.width - 24px - self.width;
                y: (parent.height - 40px) / 2;
                width: Math.max(96px, vtext.preferred-width + 32px);
                height: 40px;
                border-radius: 20px;
                background: Theme.chip;
                vtext := Text {
                    width: parent.width;
                    height: parent.height;
                    text: r.value;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if r.value == "" && r.id != "status" && r.id != "" : Text {
                x: parent.width - 44px;
                width: 28px;
                height: parent.height;
                text: "›";
                font-size: 28px;
                color: Theme.ink-mute;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if r.id == "status" : Rectangle {
                x: parent.width - 190px;
                y: (parent.height - 32px) / 2;
                width: 166px;
                height: 32px;
                border-radius: 16px;
                background: root.ok ? Theme.success-soft : Theme.danger-soft;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.ok ? "Всё в норме" : "Требует внимания";
                    font-size: 15px;
                    font-weight: 600;
                    color: root.ok ? Theme.success-ink : Theme.danger-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            mp-ta := TouchArea {
                enabled: r.id != "" && (root.role == 1 || !r.admin);
                clicked => {
                    root.page-tap(r.id);
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    default-font-family: Theme.family;
    property <length> px: 0px;
    property <length> cx: 0px;
    property <length> pr: 0px;
    property <length> cr: 0px;
    property <length> gdxr: 0px;
    property <int> gdir: 0;
    property <bool> gbusy: false;
    property <bool> can-prev: root.screen == 2 ? root.items-page-no > 0 : root.page-no > 0;
    property <bool> can-next: root.screen == 2 ? root.items-page-no < root.items-pages-total - 1 : root.page-no < root.pages-total - 1;
    pure function resist(dx: length) -> length {
        return dx < 0px ? (root.can-next ? dx : dx / 4) : (root.can-prev ? dx : dx / 4);
    }
    function drag-move(dx: length) {
        if (root.gbusy) { return; }
        root.px = root.pr + root.resist(dx);
    }
    function drag-release(dx: length) {
        if (root.gbusy) { return; }
        root.gdxr = root.resist(dx);
        root.gbusy = true;
        if (dx < -90px && root.can-next) {
            root.gdir = 1;
            root.cx = root.cr - root.width - root.gdxr;
            exit-t.running = true;
        } else if (dx > 90px && root.can-prev) {
            root.gdir = -1;
            root.cx = root.cr + root.width - root.gdxr;
            exit-t.running = true;
        } else {
            // Недотянутый свайп: панель возвращается на место с анимацией,
            // база не меняется — смещение не накапливается.
            root.cx = root.cr;
            back-t.running = true;
        }
    }
    exit-t := Timer {
        interval: 110ms;
        running: false;
        triggered => {
            exit-t.running = false;
            root.px = root.pr + root.gdxr + 2 * root.gdir * root.width;
            if (root.gdir > 0) { root.more(); } else { root.back(); }
            root.cx = root.cr - 2 * root.gdir * root.width - root.gdxr;
            back-t.running = true;
        }
    }
    back-t := Timer {
        interval: 160ms;
        running: false;
        triggered => {
            back-t.running = false;
            // Конец цикла: чистый ноль у обеих панелей — телепорты не
            // накапливаются в базах, смещение не наследуется следующим
            // экраном или страницей.
            root.px = 0px;
            root.pr = 0px;
            root.cx = 0px;
            root.cr = 0px;
            root.gbusy = false;
        }
    }
    title: "OpenScale";
    in property <length> screen-w: 1024px;
    in property <length> screen-h: 768px;
    width: screen-w;
    height: screen-h;
    background: Theme.bg;
    in property <string> weight-text: "0.000";
    in property <int> weight-state: 0;
    in property <bool> scales-ok: false;
    in property <bool> printer-fault: false;
    in property <int> paper-state: 0;
    in property <bool> paper-popup-open: false;
    in property <bool> printer-power-hint: false;
    in property <bool> label-waiting: false;
    in property <int> phase: 0;
    in property <string> status-text: "";
    in property <int> status-level: 0; 
    in property <int> screen: 0;
    in property <string> admin-title: "МЕНЮ НАСТРОЕК";
    in property <bool> admin-back-visible: false;
    in property <string> screen-title: "";
    in property <int> page-no: 0;
    in property <int> pages-total: 1;
    in property <int> items-page-no: 0;
    in property <int> items-cell-offset: 0;
    in property <int> items-pages-total: 1;
    in property <int> items-cols: 9;
    in property <length> items-col-w: 108px;
    in property <int> dept-pages-total: 1;
    in property <PluTile> popup-plu;
    in property <bool> popup-open: false;
    in property <string> popup-weight;
    in property <string> popup-sum;
    in property <string> popup-card-sum;
    in property <bool> popup-empty: true;
    in property <bool> popup-under-min: false;
    in property <bool> popup-unstable: false;
    in property <bool> popup-scales-off: false;
    in property <bool> db-unavailable: false;
    in property <string> db-error-text: "";
    callback plu-confirm();
    callback plu-cancel();
    in property <length> dept-font: 30px; 
    in property <image> logo-img;
    in property <bool> logo-has: false;
    in property <length> col-w: 195px; 
    in property <length> tile-h: 592px; 
    in property <int> dept-cols: 1;
    in property <length> pager-y: 768px;
    in property <bool> dept-cell: false;
    in property <string> goods-deptview: "колонки";
    in property <[DeptDef]> depts;         
    in property <[DeptDef]> header-depts;  
    in property <[PluTile]> items;        
    callback dept-tapped(string);
    callback plu-tapped(string);
    callback more();
    callback back();
    callback catalog-back();
    callback dept-next();
    callback dept-prev();
    callback up();
    in-out property <bool> logo-pressed: false;
    callback search-open();
    callback key-tapped(string);
    callback search-clear();
    in property <string> search-text;
    property <[string]> kb1: ["й","ц","у","к","е","н","г","ш","щ","з","х","ъ"];
    property <[string]> kb2: ["ф","ы","в","а","п","р","о","л","д","ж","э"];
    property <[string]> kb3: ["я","ч","с","м","и","т","ь","б","ю"];
    property <[string]> kb4: ["1","2","3","4","5","6","7","8","9","0","-","ё"];
    property <[string]> kb-en1: ["q","w","e","r","t","y","u","i","o","p"];
    property <[string]> kb-en2: ["a","s","d","f","g","h","j","k","l"];
    property <[string]> kb-en3: ["z","x","c","v","b","n","m"];
    in-out property <bool> img-latin;
    property <bool> can-tap: phase != 2 && phase != 3 && phase != 4;
    in property <[AdminRow]> admin-rows;
    in property <string> pin-mask;
    in property <string> pin-prompt: "Введите старый пароль";
    in property <string> pin-placeholder: "пароль";
    in property <string> pin-error;
    in property <bool> pin-forced: false;
    in property <int> lock-left;
    in property <int> role: 0;
    callback pin-digit(string);
    callback pin-clear();
    callback pin-back();
    callback pin-try();
    callback depts-close();
    callback admin-close();
    callback admin-up(string);
    callback admin-down(string);
    callback admin-del(string);
    callback admin-color(string);
    callback menu-tap(string);
    in property <int> setup-mode;
    in property <int> setup-stage;
    in property <int> setup-mask;
    in property <string> setup-note;
    in property <string> setup-action-label;
    in property <bool> setup-action-enabled: false;
    in property <string> setup-back-label: "НАЗАД";
    in property <bool> setup-skip-visible: false;
    in property <string> setup-skip-label: "ПРОПУСТИТЬ";
    in property <bool> setup-next-visible: false;
    in property <bool> setup-menu-visible: false;
    callback setup-tap(string);
    in property <[NetworkField]> net-rows;
    in property <int> net-focus;
    in property <string> net-popup-text;
    in property <bool> net-popup-ok: true;
    in property <bool> net-popup-open;
    callback net-popup-close();
    in property <bool> net-dhcp;
    in property <[NetworkField]> img-rows;
    in property <int> img-focus;
    in property <string> img-status;
    in property <bool> img-ok: true;
    in property <bool> img-busy;
    callback img-tap(int);
    callback img-key(string);
    callback img-save();
    callback img-fetch();
    in property <string> goods-cols: "2";
    in property <string> goods-sort: "по алфавиту";
    in property <string> goods-idle: "30 с";
    in property <string> goods-cardname: "ВКЛ";
    in property <string> goods-backbtn: "ВКЛ";
    in property <string> goods-itemscols: "9 столбцов";
    in property <string> goods-itemsort: "по алфавиту";
    in property <bool> card-show-name: true;
    in property <bool> catalog-back-btn: true;
    in property <int> header-page: 0;
    in property <string> trade-rounding: "выкл";
    in property <string> trade-minw: "10 г";
    in property <[string]> imp-files;
    in property <bool> imp-popup-open: false;
    in property <bool> imp-confirm: false;
    in property <string> imp-popup-text;
    in property <bool> imp-popup-ok: true;
    callback import-tap(string);
    callback import-apply();
    callback imp-popup-close();
    in property <string> report-text;
    in property <string> report-period: "Сегодня";
    in property <string> report-kind: "Все события";
    in property <[ReportOp]> report-ops;
    in property <bool> reprint-popup-open: false;
    in property <bool> reprint-confirm: false;
    in property <string> reprint-popup-text;
    in property <bool> reprint-popup-ok: true;
    callback reprint-ask(int);
    callback reprint-confirm-apply();
    callback reprint-popup-close();
    in property <[string]> actionlog-rows;
    in property <[string]> status-rows;
    callback status-refresh();
    in property <[MaintRow]> maint-rows;
    in property <bool> maint-busy: false;
    callback maint-refresh();
    callback maint-backup();
    callback actionlog-refresh();
    in property <[string]> labels-rows;
    in property <[string]> labels-files;
    in property <string> labels-status;
    in property <bool> labels-popup-open: false;
    in property <bool> labels-confirm: false;
    in property <string> labels-popup-text;
    in property <bool> labels-popup-ok: true;
    in property <bool> labels-preview-open: false;
    in property <bool> labels-preview-importable: false;
    in property <float> labels-preview-scale: 8.0;
    in property <float> labels-preview-h: 38.0;
    in property <[LabelPreviewRow]> labels-preview-rows;
    in property <string> labels-preview-name;
    callback labels-tap(int);
    callback labels-delete-tap(int);
    callback labels-import-tap(int);
    callback labels-calibrate();
    callback labels-probe();
    callback labels-confirm-apply();
    callback labels-popup-close();
    callback labels-preview-close();
    callback labels-preview-import();
    in property <string> prn-diag-text: "Идёт опрос принтера…";
    in property <bool> net-valid: false;
    callback net-mode(bool);
    callback net-tap(int);
    callback net-key(string);
    callback net-apply();
    in property <string> diag-text;
    Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: 20px;
        background: root.printer-fault || !root.scales-ok || status-level == 2 ? Theme.danger-bright
                  : root.paper-state != 0 ? Theme.warning-soft
                  : root.label-waiting ? Theme.warning-soft
                  : status-level == 1 ? Theme.warning-soft : Theme.success-soft;
        Text {
            x: 16px;
            width: 992px;
            height: 20px;
                        text: root.status-text != "" ? root.status-text
                : !root.scales-ok ? "Ошибка весов. Позовите сотрудника"
                : root.printer-fault ? "Ошибка печати. Позовите сотрудника"
                : root.label-waiting ? "Уберите этикетку из лотка"
                : root.paper-state == 2 ? "Лента закончилась. Позовите сотрудника"
                : root.paper-state == 1 ? "Лента заканчивается" : "";
            font-size: 13px;
            vertical-alignment: center;
            color: root.printer-fault || !root.scales-ok || status-level == 2 ? Theme.surface
                 : root.paper-state != 0 || status-level == 1 ? Theme.warning-ink : Theme.success;
        }
    }
    // Шапка: карточка веса слева, карточка логотипа справа (экраны 0–3)
    Rectangle {
        x: 8px; y: 36px;
        width: 460px; height: 124px;
        border-radius: Theme.r-card;
        background: Theme.surface;
        Rectangle {
            x: 16px; y: 8px;
            width: 140px; height: 22px;
            border-radius: 11px;
            background: weight-state == 2 ? Theme.success-dark
                     : weight-state == 1 ? Theme.warning-soft : Theme.chip;
            Text {
                width: parent.width;
                height: parent.height;
                text: weight-state == 2 ? "Вес стабилен"
                    : weight-state == 1 ? "Вес нестабилен" : "Ожидание";
                font-size: 13px;
                font-weight: 700;
                color: weight-state == 2 ? Theme.surface
                     : weight-state == 1 ? Theme.warning-ink : Theme.ink-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            x: 16px; y: 6px;
            width: 356px; height: 112px;
            text: root.weight-text;
            font-size: Theme.font-display;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: weight-state == 0 ? Theme.ink-faint
                 : weight-state == 1 ? Theme.warning-deep : Theme.ink;
        }
        Text {
            x: 384px; y: 80px;
            text: "кг";
            font-size: Theme.font-lg;
            color: Theme.ink-mute;
        }
        if weight-state == 1 || weight-state == 2 : Rectangle {
            x: 16px; y: 116px;
            width: 428px; height: 4px;
            border-radius: 2px;
            background: weight-state == 2 ? Theme.success-bright : Theme.warning-strong;
        }
    }
     property <length> logo-h: (root.width - 496px) * (88px / 480px);
     if root.logo-has : Rectangle {
         x: 480px; y: 36px;
         width: root.width - 496px;
         height: 124px;
         border-radius: Theme.r-card;
         background: Theme.surface;
         clip: true;
         Image {
             x: 24px; y: (parent.height - root.logo-h) / 2;
             width: parent.width - 48px;
             height: root.logo-h;
             image-fit: fill;
             source: root.logo-img;
         }
     }
     if !root.logo-has : Rectangle {
         x: 480px; y: 36px;
         width: root.width - 496px;
         height: 124px;
         border-radius: Theme.r-card;
         background: Theme.surface;
     }
     TouchArea {
          x: 480px;
          y: 36px;
          width: root.width - 496px;
          height: 124px;
          // Не дизейблим при смене экрана: задизейбленный TouchArea не получит
          // отпускание, logo-pressed залипнет, и тик будет считать логотип
          // удержанным бесконечно. Проверку экрана делаем в down.
          pointer-event(ev) => {
              if ev.kind == PointerEventKind.down {
                  root.logo-pressed = root.screen == 0 || root.screen == 2 || root.screen == 3;
              } else if ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel {
                  root.logo-pressed = false;
              }
          }
          clicked => { }
      }
    if screen == 0 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;
        Rectangle {
            x: root.px;
            width: parent.width;
            height: parent.height;
          Rectangle {
            x: root.cx;
            width: parent.width;
            height: parent.height;
            animate x { duration: 150ms; easing: ease-out; }
            for d[i] in root.depts : DeptTile {
                cell: root.dept-cell;
                idx: i;
                cols: root.dept-cols;
                col-w: root.col-w;
                tile-h: root.tile-h;
                font: root.dept-font;
                d: d;
                active: root.can-tap && !root.gbusy;
                tapped(dept) => { if (!root.gbusy) { root.dept-tapped(dept); } }
                dragging(dx) => { root.drag-move(dx); }
                drag-end(dx) => { root.drag-release(dx); }
            }
          }
        }
    }
    if screen == 0 && pages-total > 1 : Rectangle {
        y: root.pager-y;
        x: 0;
        width: root.width;
        height: 56px;
        if page-no > 0 : Rectangle {
            x: 16px;
            y: 0;
            width: 200px;
            height: 56px;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            background: pager-back-ta.pressed ? Theme.pressed : Theme.surface;
            Text {
                text: "← НАЗАД";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.ink-soft;
            }
            pager-back-ta := TouchArea {
                clicked => { root.back(); }
            }
        }
        if page-no < pages-total - 1 : Rectangle {
            x: root.width - 216px;
            y: 0;
            width: 200px;
            height: 56px;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            background: pager-more-ta.pressed ? Theme.pressed : Theme.surface;
            Text {
                text: "ДАЛЕЕ →";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.ink-soft;
            }
            pager-more-ta := TouchArea {
                clicked => { root.more(); }
            }
        }
    }
    if screen == 2 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;
        // Хедер каталога: кнопка «назад» ИЛИ лента чипов отделов (опция) + поиск
        Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: 56px;
            if root.catalog-back-btn : Rectangle {
                x: 8px; y: 8px;
                width: 110px; height: 40px;
                border-radius: 20px;
                background: cat-back-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "Меню";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cat-back-ta := TouchArea {
                    clicked => { root.catalog-back(); }
                }
            }
            if !root.catalog-back-btn : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: 56px;
                for d[i] in root.header-depts : Rectangle {
                    x: 8px + i * 114px;
                    y: 8px;
                    width: 110px;
                    height: 40px;
                    border-radius: 20px;
                    border-width: d.name == root.screen-title ? 0px : 1px;
                    border-color: Theme.border;
                    background: d.name == root.screen-title ? Theme.ink
                             : hd-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        height: parent.height;
                        text: d.name;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        overflow: elide;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: d.name == root.screen-title ? Theme.surface : Theme.ink;
                    }
                    hd-ta := TouchArea {
                        clicked => { root.dept-tapped(d.name); }
                    }
                }
                if root.header-page > 0 : Rectangle {
                    x: 8px + root.header-depts.length * 114px;
                    y: 8px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: dept-prev-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "‹";
                        font-size: 22px;
                        font-weight: 700;
                        color: Theme.ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    dept-prev-ta := TouchArea {
                        clicked => { root.dept-prev(); }
                    }
                }
                if root.header-page < root.dept-pages-total - 1 : Rectangle {
                    x: 8px + root.header-depts.length * 114px
                        + (root.header-page > 0 ? 44px : 0px);
                    y: 8px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: dept-next-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "›";
                        font-size: 22px;
                        font-weight: 700;
                        color: Theme.ink-soft;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    dept-next-ta := TouchArea {
                        clicked => { root.dept-next(); }
                    }
                }
            }
            // Поиск: пилюля с лупой
            Rectangle {
                x: root.width - 308px; y: 8px;
                width: 300px; height: 40px;
                border-radius: 20px;
                border-width: 1px;
                border-color: Theme.border;
                background: search2-ta.pressed ? Theme.pressed : Theme.surface;
                Rectangle { // лупа: обод
                    x: 16px; y: 12px;
                    width: 11px; height: 11px;
                    border-radius: 6px;
                    border-width: 2px;
                    border-color: Theme.ink-faint;
                }
                Text { // лупа: ручка
                    x: 25px; y: 21px;
                    width: 8px; height: 8px;
                    text: "⌐";
                    font-size: 8px;
                    color: Theme.ink-mute;
                    vertical-alignment: center;
                }
                Text {
                    x: 44px;
                    width: parent.width - 56px;
                    height: parent.height;
                    text: "Поиск товара";
                    font-size: Theme.font-xs;
                    color: Theme.ink-mute;
                    vertical-alignment: center;
                }
                search2-ta := TouchArea {
                    clicked => { root.search-open(); }
                }
            }
        }
        Rectangle {
            x: root.px;
            width: parent.width;
            height: parent.height;
          Rectangle {
            x: root.cx;
            width: parent.width;
            height: parent.height;
            animate x { duration: 150ms; easing: ease-out; }
            if root.items-page-no > 0 && root.catalog-back-btn : Rectangle {
                x: 8px;
                y: 56px;
                width: root.items-col-w;
                height: 178px;
                border-radius: Theme.r-button;
                background: prev2-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: "‹";
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                    color: Theme.ink-soft;
                }
                prev2-ta := TouchArea {
                    clicked => { root.back(); }
                }
            }
            for p[i] in root.items : PluCard {
                idx: i;
                cell-offset: root.items-cell-offset;
                cols: root.items-cols;
                col-w: root.items-col-w;
                p: p;
                active: root.can-tap && !root.gbusy;
                card-show-name: root.card-show-name;
                tapped => { root.plu-tapped(p.id); }
                dragging(dx) => { root.drag-move(dx); }
                drag-end(dx) => { root.drag-release(dx); }
            }
            if root.items-page-no < root.items-pages-total - 1 : Rectangle {
                x: 8px + Math.mod(root.items.length + root.items-cell-offset, root.items-cols) * (root.items-col-w + 8px);
                y: 56px + Math.floor((root.items.length + root.items-cell-offset) / root.items-cols) * 182px;
                width: root.items-col-w;
                height: 178px;
                border-radius: Theme.r-button;
                background: next2-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: "›";
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                    color: Theme.ink-soft;
                }
                next2-ta := TouchArea {
                    clicked => { root.more(); }
                }
            }
          }
        }
    }
    if screen == 0 : Rectangle {
        x: root.width / 2 - 200px;
        y: root.pager-y;
        width: 400px;
        height: 56px;
        border-radius: Theme.r-card;
        border-width: 1px;
        border-color: Theme.border;
        background: search-ta.pressed ? Theme.pressed : Theme.surface;
        Text {
            x: 16px;
            width: parent.width - 32px;
            height: parent.height;
            text: "Поиск товара";
            font-size: Theme.font-lg;
            color: Theme.ink-mute;
            vertical-alignment: center;
        }
        search-ta := TouchArea {
            clicked => { root.search-open(); }
        }
    }
    if screen == 3 : Rectangle {
        x: 0; y: 160px;
        width: root.width;
        height: root.height - 160px;
        Rectangle {
            x: 8px; y: 8px;
            width: 180px; height: 56px;
            border-radius: Theme.r-card;
            background: search-back-ta.pressed ? Theme.pressed : Theme.surface;
            Text {
                text: "← Назад";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.ink;
            }
            search-back-ta := TouchArea {
                clicked => { root.up(); }
            }
        }
        Rectangle {
            x: 204px; y: 8px;
            width: 620px; height: 56px;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: root.search-text == "" ? "Введите название…" : root.search-text;
                font-size: Theme.font-body;
                color: root.search-text == "" ? Theme.ink-faint : Theme.ink;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: 840px; y: 8px;
            width: 176px; height: 56px;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            background: search-clear-ta.pressed ? Theme.pressed : Theme.surface;
            Text {
                text: "ОЧИСТИТЬ";
                font-size: Theme.font-sm;
                font-weight: 700;
                color: Theme.ink-soft;
            }
            search-clear-ta := TouchArea {
                clicked => { root.search-clear(); }
            }
        }
        for p[i] in root.items : Rectangle {
            x: 8px;
            y: 72px + i * 64px;
            width: 1008px;
            height: 56px;
            border-radius: Theme.r-button;
            background: res-ta.pressed ? Theme.pressed : Theme.surface;
            if p.hl-match == "" : Text {
                x: 16px;
                width: 560px;
                height: parent.height;
                text: p.name;
                font-size: Theme.font-sm;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if p.hl-match != "" : HorizontalLayout {
                x: 16px;
                width: 560px;
                height: parent.height;
                Text {
                    text: p.hl-before;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                    color: Theme.ink;
                }
                Text {
                    text: p.hl-match;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: Theme.accent;
                }
                Text {
                    text: p.hl-after;
                    font-size: Theme.font-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: Theme.ink;
                }
            }
            Text {
                x: 584px;
                width: 190px;
                height: parent.height;
                text: p.price;
                font-size: Theme.font-md;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: p.card-price == "" ? Theme.ink : Theme.ink-faint;
            }
            if p.card-price != "" : Text {
                x: 790px;
                width: 190px;
                height: parent.height;
                text: p.card-price;
                font-size: Theme.font-md;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.success-bright;
            }
            res-ta := TouchArea {
                clicked => { root.plu-tapped(p.id); }
            }
        }
        if root.items.length == 0 && root.search-text == "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Начните вводить название товара";
            font-size: Theme.font-body;
            horizontal-alignment: center;
            color: Theme.ink-mute;
        }
        if root.items.length == 0 && root.search-text != "" : Text {
            x: 0; y: 80px;
            width: root.width;
            text: "Ничего не найдено";
            font-size: Theme.font-body;
            horizontal-alignment: center;
            color: Theme.ink-mute;
        }
        for k[i] in root.kb1 : KbKey {
            kx: 8px + i * 78px;
            y: 404px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb2 : KbKey {
            kx: 82px + i * 78px;
            y: 470px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb3 : KbKey {
            kx: 8px + i * 78px;
            y: 536px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 712px;
            y: 536px;
            kw: 170px;
            key: "ПРОБЕЛ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        KbKey {
            kx: 890px;
            y: 536px;
            kw: 118px;
            key: "ЗАБОЙ";
            key-tapped(k) => { root.key-tapped(k); }
        }
        for k[i] in root.kb4 : KbKey {
            kx: 8px + i * 78px;
            y: 602px;
            key: k;
            key-tapped(k) => { root.key-tapped(k); }
        }
    }
    if root.popup-open : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: transparent;
        popup-back-ta := TouchArea {
            clicked => { root.plu-cancel(); }
        }
        property <bool> bs-in: false;
        Timer {
            interval: 1ms;
            running: !bs-in;
            triggered => { bs-in = true; }
        }
        Rectangle {
            x: 0;
            y: !parent.bs-in ? root.height : root.height - 420px;
            width: root.width;
            height: 420px;
            border-radius: Theme.r-panel;
            background: Theme.surface;
            animate y { duration: 200ms; easing: ease-out; }
            popup-panel-ta := TouchArea { }
            Rectangle { // ручка
                x: (parent.width - 40px) / 2;
                y: 8px;
                width: 40px; height: 4px;
                border-radius: 2px;
                background: Theme.pressed;
            }
            Rectangle { // фото в пастельном квадрате
                x: 24px; y: 32px;
                width: 120px; height: 120px;
                border-radius: 14px;
                clip: true;
                background: Theme.chip;
                if root.popup-plu.has-img : Image {
                    width: 100%; height: 100%;
                    image-fit: contain;
                    source: root.popup-plu.img;
                }
            }
            if root.card-show-name : Text {
                x: 160px; y: 32px;
                width: parent.width - 660px; height: 44px;
                text: root.popup-plu.name;
                font-size: 16px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                vertical-alignment: center;
                color: Theme.ink;
            }
            Text {
                x: 160px; y: 80px;
                width: 300px; height: 20px;
                text: "PLU " + root.popup-plu.id;
                font-size: 14px;
                color: Theme.ink-mute;
                vertical-alignment: center;
            }
            // Правая колонка: «К оплате», вес, цена
            Text {
                x: 544px; y: 32px;
                width: 456px; height: 22px;
                text: "К оплате";
                font-size: 16px;
                color: Theme.ink-mute;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if !root.popup-empty : Text {
                x: 544px; y: 54px;
                width: 456px; height: 52px;
                text: root.popup-sum;
                font-size: 40px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if !root.popup-empty && root.popup-plu.card-price != "" : Text {
                x: 544px; y: 108px;
                width: 456px; height: 20px;
                text: "Со скидочной картой: " + root.popup-card-sum;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: Theme.success-bright;
            }
            Text { // ВЕС — виден всегда, оператор читает показания весов
                x: 544px; y: 266px;
                width: 220px; height: 20px;
                text: "ВЕС";
                font-size: 14px;
                font-weight: 700;
                color: Theme.ink-mute;
                vertical-alignment: center;
            }
            Text {
                x: 544px; y: 286px;
                width: 220px; height: 34px;
                text: root.popup-weight;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
                color: root.popup-empty
                    ? (root.popup-scales-off ? Theme.ink-faint : Theme.warning-deep)
                    : Theme.ink;
            }
            Text { // ЦЕНА — известна из карточки, видна без веса
                x: 784px; y: 266px;
                width: 216px; height: 20px;
                text: "ЦЕНА";
                font-size: 14px;
                font-weight: 700;
                color: Theme.ink-mute;
                vertical-alignment: center;
            }
            Text {
                x: 784px; y: 286px;
                width: 216px; height: 34px;
                text: root.popup-plu.price;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
                color: Theme.ink;
            }
            if root.popup-empty : Text {
                x: 24px; y: 140px;
                width: parent.width - 540px; height: 48px;
                text: root.popup-scales-off ? "Весы недоступны"
                    : root.popup-unstable ? "Вес нестабилен"
                    : root.popup-under-min ? "Вес слишком мал"
                    : "Положите товар на весы";
                font-size: Theme.font-lg;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: root.popup-scales-off || root.popup-under-min ? Theme.danger
                     : root.popup-unstable ? Theme.warning-deep : Theme.ink-faint;
            }
            Rectangle { // отмена
                x: 24px; y: 340px;
                width: 180px; height: 56px;
                border-radius: Theme.r-button;
                background: popup-cancel-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: "Отмена";
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.ink;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                popup-cancel-ta := TouchArea {
                    clicked => { root.plu-cancel(); }
                }
            }
            AppButton { // напечатать этикетку
                x: 216px; y: 340px;
                width: parent.width - 240px; height: 56px;
                kind: 1;
                label: "Напечатать этикетку";
                font-size: 18px;
                text-color: Theme.surface;
                enabled: !root.popup-empty && root.weight-state == 2;
                clicked => { root.plu-confirm(); }
            }
        }
    }
    if root.paper-popup-open && root.screen <= 3 : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        background: Theme.overlay-strong;
        paper-popup-ta := TouchArea { }
        Rectangle {
            x: (root.width - 640px) / 2;
            y: (root.height - 330px) / 2;
            width: 640px;
            height: 330px;
            border-radius: Theme.r-panel;
            background: Theme.surface;
            Text {
                x: 32px;
                y: 30px;
                width: parent.width - 64px;
                text: "Закончилась бумага в принтере";
                font-size: Theme.font-h3;
                font-weight: 700;
                color: Theme.danger;
            }
            Text {
                x: 32px;
                y: 110px;
                width: parent.width - 64px;
                text: root.printer-power-hint
                    ? "Принтер не восстановился автоматически.\nВыключите и включите питание принтера.\nЕсли проблема повторяется — обратитесь в сервис."
                    : "Проверьте ленту в принтере и перезаправьте, если нужно.\nЗатем выключите весы на несколько секунд и включите обратно.";
                font-size: Theme.font-body;
                color: Theme.ink;
                wrap: word-wrap;
            }
        }
    }
    if root.screen >= 4 : Rectangle {
        x: 0; y: 0;
        width: root.screen-w;
        height: root.screen-h;
        background: Theme.bg;
        admin-block-ta := TouchArea { }
        Rectangle {
            x: 8px; y: 8px;
            width: parent.width - 16px;
            height: 64px;
            border-radius: Theme.r-card;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.surface;
            Text {
                x: 16px;
                width: parent.width - 440px;
                height: parent.height;
                text: root.admin-title;
                font-size: Theme.font-h3;
                font-weight: 700;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-alignment: TextHorizontalAlignment.left;
                overflow: elide;
            }
            if root.admin-back-visible && !root.pin-forced : Rectangle {
                x: parent.width - 336px;
                y: 8px;
                width: 160px;
                height: 48px;
                border-radius: Theme.r-button;
                background: admin-back-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: "НАЗАД";
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.ink;
                }
                admin-back-ta := TouchArea {
                    clicked => { root.depts-close(); }
                }
            }
            if root.screen != 19 : Rectangle {
                x: parent.width - 176px;
                y: 8px;
                width: 160px;
                height: 48px;
                border-radius: Theme.r-button;
                background: admin-done-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: root.screen == 4 ? "ГОТОВО" : "ВЫХОД";
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.ink;
                }
                admin-done-ta := TouchArea {
                    clicked => { root.admin-close(); }
                }
            }
        }
        if root.screen == 10 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            Text {
                x: 0; y: 8px;
                width: parent.width;
                height: 32px;
                text: root.pin-prompt;
                font-size: Theme.font-h3;
                font-weight: 700;
                color: Theme.ink;
                horizontal-alignment: center;
            }
            Rectangle {
                x: 262px;
                y: 44px;
                width: 500px;
                height: 64px;
                border-radius: Theme.r-card;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                Text {
                    text: root.pin-mask == "" ? "пароль" : root.pin-mask;
                    font-size: Theme.font-h2;
                    font-weight: 700;
                    color: root.pin-mask == "" ? Theme.ink-faint : Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pin-error != "" : Text {
                x: 0; y: 112px;
                width: parent.width;
                height: 32px;
                text: root.pin-error;
                font-size: Theme.font-body;
                font-weight: 700;
                color: Theme.danger;
                horizontal-alignment: center;
            }
            property <[string]> keys: ["1","2","3","4","5","6","7","8","9","C","0","←"];
            for k[i] in keys : Rectangle {
                x: 262px + mod(i, 3) * 170px;
                y: 152px + floor(i / 3) * 100px;
                width: 160px;
                height: 92px;
                border-radius: Theme.r-card;
                background: kb2-ta.pressed ? Theme.pressed-deep : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: k;
                    font-size: Theme.font-h1;
                    font-weight: 700;
                    color: Theme.ink;
                }
                kb2-ta := TouchArea {
                    clicked => {
                        k == "C" ? root.pin-clear()
                        : k == "←" ? root.pin-back()
                        : root.pin-digit(k);
                    }
                }
            }
            Rectangle {
                x: 262px;
                y: 608px;
                width: 500px;
                height: 64px;
                border-radius: Theme.r-card;
                background: root.pin-mask == ""
                    ? Theme.border-soft
                    : (pin-save-ta.pressed ? Theme.success-dark : Theme.success);
                Text {
                    text: "ДАЛЕЕ";
                    font-size: Theme.font-h3;
                    font-weight: 700;
                    color: Theme.surface;
                }
                pin-save-ta := TouchArea {
                    enabled: root.pin-mask != "";
                    clicked => { root.pin-try(); }
                }
            }
        }
        if root.screen == 19 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            property <[SetupRow]> wizard-rows: [
                { label: "1 · Пароль администратора", state: root.setup-stage > 1 ? 2 : (root.setup-stage == 1 ? 1 : 0) },
                { label: "2 · Пароль кассира", state: root.setup-stage > 2 ? 2 : (root.setup-stage == 2 ? 1 : 0) },
                { label: "3 · Сеть", state: root.setup-stage > 3 ? 2 : (root.setup-stage == 3 ? 1 : 0) },
                { label: "4 · Проверка весов", state: root.setup-stage > 4 ? 2 : (root.setup-stage == 4 ? 1 : 0) },
                { label: "5 · Длина этикетки", state: root.setup-stage > 5 ? 2 : (root.setup-stage == 5 ? 1 : 0) },
                { label: "6 · Печать (тест)", state: root.setup-stage > 6 ? 2 : (root.setup-stage == 6 ? 1 : 0) },
                { label: "7 · Дата и время", state: root.setup-stage > 7 ? 2 : (root.setup-stage == 7 ? 1 : 0) },
                { label: "8 · Готово", state: root.setup-stage > 8 ? 2 : (root.setup-stage == 8 ? 1 : 0) },
            ];
            property <int> bit-goods: mod(root.setup-mask, 2);
            property <int> bit-layout: mod(floor(root.setup-mask / 2), 2);
            property <int> bit-printer: mod(floor(root.setup-mask / 4), 2);
            property <int> bit-scales: mod(floor(root.setup-mask / 8), 2);
            property <[SetupRow]> checklist-rows: [
                { label: "Товары загружены", state: bit-goods == 1 ? 2 : 1 },
                { label: "Раскладка этикетки", state: bit-layout == 1 ? 2 : 1 },
                { label: "Принтер исправен", state: bit-printer == 1 ? 2 : 1 },
                { label: "Весы исправны", state: bit-scales == 1 ? 2 : 1 },
            ];
            for row[i] in (root.setup-mode == 1 ? wizard-rows : checklist-rows) : Rectangle {
                x: 8px;
                y: 6px + i * 48px;
                width: 300px;
                height: 42px;
                border-radius: Theme.r-inner;
                border-width: 1px;
                border-color: row.state == 2 ? Theme.success
                    : (row.state == 1 && root.setup-mode == 0 ? Theme.warning
                    : (row.state == 1 ? Theme.success : Theme.border));
                background: row.state == 2 ? Theme.success-soft
                    : (row.state == 1 && root.setup-mode == 0 ? Theme.warning-soft
                    : (row.state == 1 ? Theme.success-soft : Theme.surface));
                Text {
                    x: 12px;
                    width: parent.width - 40px;
                    height: parent.height;
                    text: row.label;
                    font-size: Theme.font-md;
                    font-weight: row.state == 1 ? 700 : 500;
                    color: row.state == 0 ? Theme.ink-faint : (row.state == 1 && root.setup-mode == 0 ? Theme.warning-ink : Theme.ink);
                    vertical-alignment: center;
                    overflow: elide;
                }
                if row.state == 2 : Text {
                    x: parent.width - 34px;
                    width: 26px;
                    height: parent.height;
                    text: "✓";
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.success;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                x: 320px;
                y: 6px;
                width: parent.width - 328px;
                height: parent.height - 170px;
                border-radius: Theme.r-card;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                Text {
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: parent.height - 24px;
                    text: root.setup-note;
                    font-size: Theme.font-sm;
                    color: Theme.ink;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
            Rectangle {
                x: 320px;
                y: parent.height - 156px;
                width: 150px;
                height: 68px;
                border-radius: Theme.r-button;
                background: setup-back-ta.pressed ? Theme.pressed : Theme.chip;
                Text {
                    text: root.setup-back-label;
                    font-size: Theme.font-md;
                    font-weight: 700;
                    color: Theme.ink;
                    overflow: elide;
                }
                setup-back-ta := TouchArea {
                    clicked => { root.setup-tap("back"); }
                }
            }
            AppButton {
                x: 482px;
                y: parent.height - 156px;
                width: parent.width - 490px;
                height: 68px;
                kind: 2;
                label: root.setup-action-label;
                font-size: Theme.font-sm;
                text-color: Theme.surface;
                enabled: root.setup-action-enabled;
                clicked => { root.setup-tap("action"); }
            }
            if root.setup-skip-visible : AppButton {
                x: 320px;
                y: parent.height - 80px;
                width: parent.width - 540px;
                height: 68px;
                label: root.setup-skip-label;
                font-size: Theme.font-md;
                clicked => { root.setup-tap("skip"); }
            }
            if root.setup-next-visible : AppButton {
                x: parent.width - 208px;
                y: parent.height - 80px;
                width: 200px;
                height: 68px;
                kind: 2;
                label: "ДАЛЕЕ";
                font-size: Theme.font-sm;
                text-color: Theme.surface;
                clicked => { root.setup-tap("next"); }
            }
        }
        if root.screen == 5 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            Text {
                x: 0; y: 0;
                width: parent.width;
                height: 36px;
                text: root.pin-prompt;
                font-size: Theme.font-h3;
                font-weight: 700;
                color: Theme.ink-soft;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: 262px;
                y: 40px;
                width: 500px;
                height: 56px;
                border-radius: Theme.r-card;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                Text {
                    text: root.pin-mask == "" ? root.pin-placeholder : root.pin-mask;
                    font-size: Theme.font-h2;
                    font-weight: 700;
                    color: root.pin-mask == "" ? Theme.ink-faint : Theme.ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if root.pin-error != "" : Text {
                x: 0; y: 96px;
                width: parent.width;
                height: 36px;
                text: root.pin-error;
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.danger;
                horizontal-alignment: center;
            }
            if root.lock-left > 0 : Text {
                x: 0; y: 96px;
                width: parent.width;
                height: 36px;
                text: "Слишком много попыток. Повтор через " + root.lock-left + " с";
                font-size: Theme.font-lg;
                font-weight: 700;
                color: Theme.danger;
                horizontal-alignment: center;
            }
            property <[string]> keys: ["1","2","3","4","5","6","7","8","9","C","0","←"];
            for k[i] in keys : Rectangle {
                x: 262px + mod(i, 3) * 170px;
                y: 140px + floor(i / 3) * 116px;
                width: 160px;
                height: 106px;
                border-radius: Theme.r-card;
                background: kb-ta.pressed ? Theme.pressed-deep : Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: k;
                    font-size: Theme.font-h1;
                    font-weight: 700;
                    color: Theme.ink;
                }
                kb-ta := TouchArea {
                    clicked => {
                        k == "C" ? root.pin-clear()
                        : k == "←" ? root.pin-back()
                        : root.pin-digit(k);
                    }
                }
            }
            AppButton {
                x: 262px;
                y: 608px;
                width: 500px;
                height: 64px;
                kind: 2;
                label: "ВОЙТИ";
                font-size: Theme.font-h3;
                text-color: Theme.surface;
                enabled: root.lock-left == 0 && root.pin-mask != "";
                clicked => { root.pin-try(); }
            }
        }
        if root.screen == 6 : Rectangle {
            x: 0; y: 84px;
            width: parent.width;
            height: parent.height - 84px;
            // Меню персонала: шесть повседневных действий списком.
            if root.role == 0 : MenuPage {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                property <[MenuRow]> rows-staff: [
                    { label: "Состояние оборудования", id: "status", admin: false, sub: "Весы, принтер, бумага, выгрузка", value: "" },
                    { label: "Обнулить весы", id: "zero", admin: false, sub: "При пустой платформе", value: "" },
                    { label: "Протяжка этикетки", id: "feed", admin: false, sub: "", value: "" },
                    { label: "Тестовая печать", id: "testprint", admin: false, sub: "", value: "" },
                    { label: "Отчёты", id: "reports", admin: false, sub: "Печать по периодам", value: "" },
                    { label: "Мой PIN", id: "changepin", admin: false, sub: "", value: "" },
                ];
                rows: self.rows-staff;
                role: 1;
                page-tap(id) => { root.menu-tap(id); }
            }
            // Меню администратора: шесть категорий сеткой 2×3 и
            // отдельный блок состояния оборудования.
            if root.role != 0 : Rectangle {
                property <length> gap: 12px;
                property <length> cw: (parent.width - 24px - gap) / 2;
                property <length> ch: 148px;
                property <[MenuRow]> cats: [
                    { label: "Интерфейс", id: "goods", admin: true, sub: "Экран покупателя: отделы, товары, возврат", value: "" },
                    { label: "Весы", id: "trade", admin: true, sub: "Диагностика, обнуление, настройки веса", value: "" },
                    { label: "Этикетки и принтер", id: "equip", admin: true, sub: "Принтер, макеты, тестовая печать", value: "" },
                    { label: "Сеть и обмен", id: "catnet", admin: true, sub: "IP и время, фото товаров, конфигурация", value: "" },
                    { label: "Отчёты и журнал", id: "catreports", admin: true, sub: "Отчёты по периодам, журнал действий", value: "" },
                    { label: "Обслуживание", id: "catservice", admin: true, sub: "БД, копии, PIN, VNC, мастер, перезагрузка", value: "" },
                ];
                property <[string]> cat-icons: ["⌂", "⚖", "⎙", "⇄", "≡", "⚙"];
                for c[i] in cats : Rectangle {
                    x: 8px + Math.mod(i, 2) * (cw + gap);
                    y: 8px + Math.floor(i / 2) * (ch + gap);
                    width: cw;
                    height: ch;
                    border-radius: Theme.r-card;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: cat-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        x: 24px;
                        y: 22px;
                        width: 48px;
                        height: 56px;
                        text: cat-icons[i];
                        font-family: "DejaVu Sans";
                        font-size: 40px;
                        color: Theme.ink-soft;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 80px;
                        y: 22px;
                        width: parent.width - 104px;
                        height: 56px;
                        text: c.label;
                        font-size: 30px;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 24px;
                        y: 82px;
                        width: parent.width - 48px;
                        height: 48px;
                        text: c.sub;
                        font-size: 17px;
                        color: Theme.ink-soft;
                        vertical-alignment: top;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    cat-ta := TouchArea { clicked => { root.menu-tap(c.id); } }
                }
                Rectangle { // Состояние оборудования — с главного меню
                    x: 8px;
                    y: 3 * (ch + gap) + 8px;
                    width: parent.width - 16px;
                    height: ch;
                    border-radius: Theme.r-card;
                    border-width: 1px;
                    border-color: root.status-text == "" && root.scales-ok && !root.printer-fault ? Theme.success : Theme.danger;
                    background: st-ta.pressed ? Theme.pressed : Theme.surface;
                    Text {
                        x: 24px;
                        y: 22px;
                        width: parent.width - 48px;
                        height: 56px;
                        text: "Состояние оборудования";
                        font-size: 30px;
                        font-weight: 700;
                        color: Theme.ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 24px;
